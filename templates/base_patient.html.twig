{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body_container %}
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <aside class="col-auto col-md-3 col-lg-2 min-vh-100 d-flex flex-column p-3 text-white sticky-top shadow" style="background: #1abc9c;">
                <div class="d-flex align-items-center mb-4 px-2">
                    <span class="fs-4 fw-bold text-uppercase letter-spacing-1">Mon Espace</span>
                </div>
                <hr class="mb-4 opacity-25">
                <ul class="nav nav-pills flex-column mb-auto gap-2">
                    <li class="nav-item">
                        <a href="{{ path('app_patient_dashboard') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_patient_dashboard' ? 'active bg-dark bg-opacity-25' : '' }}">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span class="d-none d-md-inline">Tableau de bord</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_patient_creneaux_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_patient_creneaux' ? 'active bg-dark bg-opacity-25' : '' }}">
                            <i class="fa-solid fa-calendar-plus"></i>
                            <span class="d-none d-md-inline">Réserver</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_patient_rendezvous_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_patient_rendezvous' ? 'active bg-dark bg-opacity-25' : '' }}">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span class="d-none d-md-inline">Mes Rendez-vous</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_patient_programmes_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_patient_programmes' ? 'active bg-dark bg-opacity-25' : '' }}">
                            <i class="fa-solid fa-leaf"></i>
                            <span class="d-none d-md-inline">Programmes</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_messages_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_messages' ? 'active bg-dark bg-opacity-25' : '' }}">
                            <i class="fa-solid fa-envelope"></i>
                            <span class="d-none d-md-inline">Messages</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_consultation') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_consultation' ? 'active bg-dark bg-opacity-25' : '' }}">
                            <i class="fa-solid fa-comments"></i>
                            <span class="d-none d-md-inline">Forum</span>
                        </a>
                    </li>
                </ul>
                <hr class="opacity-25 mt-4">
                <div class="dropdown p-2 mt-auto">
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: bold;">
                            {{ app.user.prenom|first }}{{ app.user.nom|first }}
                        </div>
                        <strong class="d-none d-md-inline">{{ app.user.prenom }}</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                        <li><a class="dropdown-item" href="{{ path('app_patient_account_pdf') }}" target="_blank" rel="noopener">Fiche compte (PDF)</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_account_profile') }}">Mon Profil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="col ps-md-2 pt-2">
                <div class="bg-light min-vh-100 p-4 rounded-3 shadow-sm">
                    <!-- Top Bar in Content -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <h2 class="h4 mb-0 fw-bold">{% block patient_title %}Espace Patient{% endblock %}</h2>
                        <div class="text-muted small">
                            Bienvenue, {{ app.user.prenom }}
                        </div>
                    </div>

                    {% block patient_body %}{% endblock %}
                </div>
            </main>
        </div>
    </div>
{% endblock %}
