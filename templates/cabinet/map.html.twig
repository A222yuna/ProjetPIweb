{% extends 'base.html.twig' %}

{% block title %}Carte des cabinets psychologiques — Tunisie{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <style>
        #cabinet-map {
            height: 580px;
            width: 100%;
            border-radius: 1rem;
            box-shadow: 0 4px 24px rgba(0,0,0,.10);
        }
        .map-wrapper { position: relative; }
        .map-loader {
            position: absolute; inset: 0;
            display: flex; align-items: center; justify-content: center;
            background: rgba(255,255,255,.75);
            border-radius: 1rem;
            z-index: 1000;
            font-weight: 600;
            color: #6B3FA0;
            gap: .75rem;
        }
        .leaflet-popup-content-wrapper { border-radius: .75rem; }
        .cab-popup h6 { margin: 0 0 4px; color: #6B3FA0; font-size: .95rem; }
        .cab-popup p  { margin: 0 0 8px; font-size: .82rem; color: #555; }
        .cab-popup a  {
            display: inline-block; padding: 4px 14px;
            background: #6B3FA0; color: #fff;
            border-radius: 20px; font-size: .8rem;
            text-decoration: none;
        }
        .cab-popup a:hover { background: #4A2880; }
        #map-stats {
            display: flex; gap: 1rem; flex-wrap: wrap;
            margin-bottom: 1rem;
        }
        .map-stat {
            background: #fff; border-radius: .75rem;
            padding: .6rem 1.2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            font-size: .85rem; color: #555;
        }
        .map-stat strong { color: #6B3FA0; font-size: 1.1rem; }
    </style>
{% endblock %}

{% block body %}
<p class="page-eyebrow">Annuaire</p>
<h1>Carte des cabinets psychologiques</h1>
<p class="page-lead muted">Trouvez un cabinet près de chez vous en Tunisie.</p>

<div id="map-stats">
    <div class="map-stat"><strong id="stat-total">—</strong> cabinets</div>
    <div class="map-stat"><strong id="stat-cities">—</strong> villes</div>
</div>

<div class="map-wrapper">
    <div class="map-loader" id="map-loader">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             style="animation:spin 1s linear infinite">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>
        Chargement de la carte…
    </div>
    <div id="cabinet-map"></div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>@keyframes spin{to{transform:rotate(360deg)}}</style>
    <script>
    (async () => {
        // Init map centered on Tunisia
        const map = L.map('cabinet-map').setView([33.8869, 9.5375], 6);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 18,
        }).addTo(map);

        // Custom purple marker
        const purpleIcon = L.divIcon({
            className: '',
            html: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="40" viewBox="0 0 32 40">
                <path d="M16 0C7.163 0 0 7.163 0 16c0 10 16 24 16 24S32 26 32 16C32 7.163 24.837 0 16 0z"
                      fill="#6B3FA0" stroke="#fff" stroke-width="1.5"/>
                <circle cx="16" cy="16" r="7" fill="#fff"/>
                <text x="16" y="20" text-anchor="middle" font-size="10" fill="#6B3FA0" font-weight="bold">🧠</text>
            </svg>`,
            iconSize: [32, 40],
            iconAnchor: [16, 40],
            popupAnchor: [0, -40],
        });

        try {
            const res  = await fetch('{{ path("api_cabinets_map_data") }}');
            const data = await res.json();

            document.getElementById('map-loader').style.display = 'none';

            if (!data.length) {
                document.getElementById('map-loader').textContent = 'Aucun cabinet disponible.';
                document.getElementById('map-loader').style.display = 'flex';
                return;
            }

            // Stats
            const cities = new Set(data.map(c => c.ville));
            document.getElementById('stat-total').textContent  = data.length;
            document.getElementById('stat-cities').textContent = cities.size;

            const bounds = [];

            data.forEach(cab => {
                const marker = L.marker([cab.lat, cab.lng], { icon: purpleIcon }).addTo(map);

                marker.bindPopup(`
                    <div class="cab-popup">
                        <h6>🏥 ${cab.ville}</h6>
                        <p>${cab.adresse}</p>
                        <a href="${cab.url}">Voir le cabinet →</a>
                    </div>
                `);

                bounds.push([cab.lat, cab.lng]);
            });

            // Fit map to all markers
            if (bounds.length) {
                map.fitBounds(bounds, { padding: [40, 40] });
            }

        } catch (err) {
            console.error(err);
            document.getElementById('map-loader').textContent = 'Erreur de chargement.';
        }
    })();
    </script>
{% endblock %}
