{% extends 'base.html.twig' %}

{% block body_attr %} class="layout-consultation"{% endblock %}

{% block title %}Forum &amp; publications — Cabinet de psychologie{% endblock %}

{% block body %}
    {% set cover_images = [
        'https://images.unsplash.com/photo-1573497019940-1c28c88b0f9e?auto=format&fit=crop&w=600&q=75',
        'https://images.unsplash.com/photo-1516307365426-bea591f05011?auto=format&fit=crop&w=600&q=75',
        'https://images.unsplash.com/photo-1499202184017-35f4930cdf80?auto=format&fit=crop&w=600&q=75',
        'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=600&q=75',
        'https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=600&q=75',
    ] %}

    <div class="page-head-split">
        <div>
            <p class="page-eyebrow">Espace forum</p>
            <h1>Rechercher &amp; publier</h1>
            <p class="page-lead muted" style="margin-bottom:0">
                Bienvenue sur l'espace d'échange de notre cabinet. Ici, vous pouvez partager vos expériences, 
                poser vos questions et interagir avec la communauté en toute bienveillance. 
                Utilisez les filtres pour trouver les sujets qui vous intéressent ou créez votre propre publication.
            </p>
        </div>
        <figure>
            <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1200&q=80" width="900" height="675" alt="Illustration Forum - Échange et bienveillance" fetchpriority="high">
        </figure>
    </div>

    <div class="toolbar-consult">
        <form class="search-form-consult" method="get" action="{{ path('app_consultation') }}" role="search">
            <div class="field-inline">
                <label for="q">Recherche</label>
                <input id="q" type="search" name="q" value="{{ q }}" placeholder="Mots clés…" autocomplete="off">
            </div>
            <div class="field-inline">
                <label for="filtre-cat">Catégorie</label>
                <select id="filtre-cat" name="categorie" aria-label="Filtrer par catégorie">
                    <option value="">Toutes</option>
                    {% for c in category_suggestions %}
                        <option value="{{ c }}" {% if filter_categorie == c %}selected{% endif %}>{{ c }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="field-inline">
                <label for="sort">Trier par</label>
                <select id="sort" name="sort" aria-label="Trier par">
                    <option value="recent" {% if sort_by == 'recent' %}selected{% endif %}>Plus récents</option>
                    <option value="likes" {% if sort_by == 'likes' %}selected{% endif %}>Plus aimés</option>
                    <option value="comments" {% if sort_by == 'comments' %}selected{% endif %}>Plus commentés</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Filtrer</button>
            {% if q or filter_categorie or sort_by != 'recent' %}
                <a href="{{ path('app_consultation') }}" class="btn btn-outline">Réinitialiser</a>
            {% endif %}
        </form>
        <a href="{{ path('app_post_new') }}" class="btn btn-primary">Nouvelle publication</a>
    </div>

    <datalist id="consultation-categories">
        {% for c in category_suggestions %}
            <option value="{{ c }}"></option>
        {% endfor %}
    </datalist>

    {% if posts is empty %}
        <div class="card empty-state" style="margin-top:0">
            <p class="muted" style="margin:0 0 1rem">Aucune publication ne correspond à votre recherche.</p>
            <a href="{{ path('app_post_new') }}" class="btn btn-outline">Publier le premier message</a>
        </div>
    {% else %}
        <div class="post-grid">
            {% for post in posts %}
                {% set cover = post.imageUrl ? (post.imageUrl starts with '/uploads/' ? asset(post.imageUrl) : post.imageUrl) : cover_images[loop.index0 % cover_images|length] %}
                {# If it's an unsplash URL, add sizing parameters for performance #}
                {% if 'unsplash.com' in cover and '?' not in cover %}
                    {% set cover = cover ~ '?auto=format&fit=crop&w=600&q=75' %}
                {% endif %}
                <article class="post-card">
                    <div class="post-card-visual" style="background-image: url('{{ cover }}');" role="img" aria-label="" loading="lazy"></div>
                    <div class="post-card-body">
                        <h2><a href="{{ path('app_post_show', { id: post.id }) }}">{{ post.titre }}</a></h2>
                        <p class="post-card-meta">
                            {{ post.categorie }} · {{ post.auteurRole }}
                            {% if post.auteur %} · {{ post.auteur.prenom }} {{ post.auteur.nom }}{% endif %}
                        </p>
                        <p class="post-card-snippet">{{ post.contenu|length > 220 ? post.contenu|slice(0, 220) ~ '…' : post.contenu }}</p>
                        <div class="post-card-footer">
                            <span>{{ post.date|date('d/m/Y H:i') }}</span>
                            <span><span id="post-card-{{ post.id }}" class="likes-count">{{ post.nbLikes }}</span> j'aime</span>
                        </div>
                        <div class="post-card-actions" style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
                            <a href="{{ path('app_post_show', { id: post.id }) }}" class="btn btn-outline btn-sm">👁️ Voir</a>
                            <a href="{{ path('app_post_show', { id: post.id }) }}#comment-form" class="btn btn-outline btn-sm">💬 Commenter</a>
                            <button type="button" 
                               class="btn btn-outline btn-sm like-btn" 
                               data-like-url="{{ path('app_post_like', { id: post.id }) }}"
                               data-likes-counter="post-card-{{ post.id }}">
                                ❤️ J'aime
                            </button>
                            
                            {% if app.user and post.auteur and app.user.id == post.auteur.id %}
                                <a href="{{ path('app_post_edit', { id: post.id }) }}" class="btn btn-link btn-sm" style="margin-left: auto; text-decoration: none;">✏️ Modifier</a>
                                <form method="post" action="{{ path('app_post_delete', {id: post.id}) }}" onsubmit="return confirm('Supprimer définitivement cette publication ?');" style="display: inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                    <button type="submit" class="btn btn-link btn-sm" style="color: #d32f2f; padding: 0; text-decoration: none;">🗑️ Supprimer</button>
                                </form>
                            {% elseif is_granted('ROLE_ADMIN') %}
                                <form method="post" action="{{ path('app_admin_forum_post_delete', {id: post.id}) }}" onsubmit="return confirm('Supprimer définitivement cette publication ?');" style="display: inline-block; margin-left: auto;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                                    <button type="submit" class="btn btn-link btn-sm" style="color: #d32f2f; padding: 0; text-decoration: none;">🗑️ Supprimer</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}

    {% if total_pages > 1 %}
        <div class="card" style="margin-top:1rem">
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
                {% for p in 1..total_pages %}
                    <a class="btn {{ p == page ? 'btn-primary' : 'btn-outline' }} btn-sm"
                       href="{{ path('app_consultation', { page: p, q: q, categorie: filter_categorie, sort: sort_by }) }}">{{ p }}</a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
