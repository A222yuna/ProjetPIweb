{% extends 'base.html.twig' %}

{% block title %}Nouvelle publication — Forum{% endblock %}

{% block body %}
    <p class="muted back-link">
        <a href="{{ path('app_consultation') }}">← Retour au forum</a>
    </p>

    <div class="card" style="max-width: 800px; margin: 0 auto;">
        <h1>Créer une nouvelle publication</h1>
        <p class="muted" style="margin-bottom: 2rem;">
            Partagez vos questions ou vos expériences avec la communauté.
        </p>
        
        {{ form_start(form, { attr: { class: 'stack-form', enctype: 'multipart/form-data', novalidate: 'novalidate' } }) }}
            {{ form_row(form.titre) }}
            {{ form_row(form.categorie) }}
            {{ form_row(form.imageFile) }}
            {{ form_row(form.imageUrl) }}
            
            <div class="emoji-btn-wrapper">
                {{ form_label(form.contenu) }}
                <button type="button" class="emoji-trigger-btn" data-emoji-picker data-emoji-target="{{ form.contenu.vars.id }}">
                    😊 <span>Emojis</span>
                </button>
            </div>
            {{ form_widget(form.contenu) }}
            {{ form_errors(form.contenu) }}
            
            <div class="stack-form-actions">
                <button type="submit" class="btn btn-primary">Publier sur le forum</button>
                <a href="{{ path('app_consultation') }}" class="btn btn-outline">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
