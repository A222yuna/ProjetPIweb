{% extends 'base.html.twig' %}

{% block title %}Modifier la publication — Forum{% endblock %}

{% block body %}
    <p class="muted back-link">
        <a href="{{ path('app_post_show', { id: post.id }) }}">← Retour à la publication</a>
    </p>

    <div class="card" style="max-width: 800px; margin: 0 auto;">
        <h1>Modifier votre publication</h1>
        
        {{ form_start(form, { attr: { class: 'stack-form', enctype: 'multipart/form-data', novalidate: 'novalidate' } }) }}
            {{ form_row(form.titre) }}
            {{ form_row(form.categorie) }}
            {{ form_row(form.imageFile) }}
            {{ form_row(form.imageUrl) }}
            
            <div class="emoji-btn-wrapper">
                {{ form_label(form.contenu) }}
                <button type="button" class="emoji-trigger-btn" data-emoji-picker data-emoji-target="{{ form.contenu.vars.id }}">
                    😊 <span>Emojis</span>
                </button>
            </div>
            {{ form_widget(form.contenu) }}
            {{ form_errors(form.contenu) }}

            <div class="anon-toggle">
                {{ form_widget(form.isAnonymous) }}
                {{ form_label(form.isAnonymous) }}
                <p class="muted" style="margin:0.25rem 0 0; font-size:0.85rem">{{ form_help(form.isAnonymous) }}</p>
            </div>
            
            <div class="stack-form-actions">
                <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                <a href="{{ path('app_post_show', { id: post.id }) }}" class="btn btn-outline">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
