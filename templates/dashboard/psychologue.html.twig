{% extends 'base_psychologue.html.twig' %}

{% block title %}Dashboard Psychologue{% endblock %}

{% block psychologue_title %}Tableau de Bord Praticien{% endblock %}

{% block psychologue_body %}
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                        <i class="fa-solid fa-calendar-check fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-bold small ls-1">Mes Rendez-vous</h6>
                        <h3 class="mb-0 fw-bold">{{ upcoming_appointments|length }}</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                        <i class="fa-solid fa-clock fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-bold small ls-1">Disponibilités</h6>
                        <h3 class="mb-0 fw-bold">Active</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                        <i class="fa-solid fa-comments fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-bold small ls-1">Forum</h6>
                        <h3 class="mb-0 fw-bold">Participer</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-list-check text-primary"></i>
                    Dernières demandes de rendez-vous
                </h5>
                
                {% if upcoming_appointments is empty %}
                    <div class="text-center py-5">
                        <i class="fa-solid fa-calendar-xmark text-muted fs-1 mb-3"></i>
                        <p class="text-muted">Aucun rendez-vous pour le moment.</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 rounded-start">Patient</th>
                                    <th class="border-0">Date & Heure</th>
                                    <th class="border-0">Status</th>
                                    <th class="border-0 rounded-end text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for appointment in upcoming_appointments|slice(0, 5) %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-secondary bg-opacity-10 p-2 text-secondary small">
                                                    {{ appointment.patient.prenom|first }}{{ appointment.patient.nom|first }}
                                                </div>
                                                <span class="fw-semibold">{{ appointment.patient.prenom }} {{ appointment.patient.nom }}</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small">
                                                <i class="fa-regular fa-calendar me-1"></i> {{ appointment.plan.dayOfWeek }}<br>
                                                <i class="fa-regular fa-clock me-1 text-muted"></i> {{ appointment.plan.period }}
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill {% if appointment.status == 'CONFIRMED' %}bg-success{% elseif appointment.status == 'PENDING' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                                                {{ appointment.status }}
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a href="{{ path('app_psychologue_appointments_index') }}" class="btn btn-sm btn-white border shadow-sm rounded-circle">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-4">Gestion rapide</h5>
                <div class="d-grid gap-2">
                    <a href="{{ path('app_psychologue_planning_index') }}" class="btn btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2">
                        <i class="fa-solid fa-plus"></i>
                        Ajouter au planning
                    </a>
                    <a href="{{ path('app_psychologue_disponibilites_index') }}" class="btn btn-outline-primary rounded-pill d-flex align-items-center justify-content-center gap-2">
                        <i class="fa-solid fa-clock"></i>
                        Mes horaires
                    </a>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm rounded-4 p-4" style="background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%); color: white;">
                <h5 class="fw-bold mb-3">Conseil du jour</h5>
                <p class="small opacity-75 mb-0">
                    "Prendre soin de sa santé mentale est aussi important que prendre soin de sa santé physique."
                </p>
                <hr class="my-3 opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-lightbulb text-warning"></i>
                    <small>N'oubliez pas de mettre à jour vos disponibilités régulièrement.</small>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
