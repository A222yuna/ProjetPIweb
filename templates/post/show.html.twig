{% extends 'base.html.twig' %}

{% block title %}{{ post.titre }} — Cabinet de psychologie{% endblock %}

{% block body %}
    <p class="muted back-link"><a href="{{ path('app_consultation') }}">← Retour aux consultations</a></p>

    <article class="card">
        <h1>{{ post.titre }}</h1>
        <p class="muted">
            {{ post.categorie }} · {{ post.auteurRole }}
            {% if post.auteur %} · {{ post.auteur.prenom }} {{ post.auteur.nom }}{% endif %}
            · {{ post.date|date('d/m/Y H:i') }}
        </p>
        <div class="post-body">{{ post.contenu }}</div>
        <div class="post-actions" style="display:flex;gap:0.75rem;flex-wrap:wrap;margin:1rem 0;align-items:center">
            <button type="button" class="btn btn-primary btn-sm like-btn" data-like-url="{{ path('app_post_like', { id: post.id }) }}" data-likes-counter="post-{{ post.id }}">
                👍 J'aime
            </button>
            <a href="#comment-form" class="btn btn-outline btn-sm">Commenter</a>
            
            {% if app.user and post.auteur and app.user.id == post.auteur.id %}
                <a href="{{ path('app_post_edit', { id: post.id }) }}" class="btn btn-outline btn-sm" style="margin-left: auto;">✏️ Modifier</a>
                <form method="post" action="{{ path('app_post_delete', {id: post.id}) }}" onsubmit="return confirm('Supprimer définitivement cette publication ?');" style="display: inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                    <button type="submit" class="btn btn-link btn-sm" style="color: #d32f2f; padding: 0; text-decoration: none;">🗑️ Supprimer</button>
                </form>
            {% elseif is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('app_admin_forum_post_delete', {id: post.id}) }}" onsubmit="return confirm('Supprimer définitivement cette publication ?');" style="display: inline-block; margin-left: auto;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                    <button type="submit" class="btn btn-link btn-sm" style="color: #d32f2f; padding: 0; text-decoration: none;">🗑️ Supprimer (Admin)</button>
                </form>
            {% endif %}
        </div>
        <p class="muted likes-line"><span id="post-{{ post.id }}" class="likes-count">{{ post.nbLikes }}</span> j'aime</p>
    </article>

    {% set comments = post.commentaires %}
    {% set topLevelComments = comments|filter(c => c.parent is null) %}
    <h2>Commentaires ({{ comments|length }})</h2>
    {% if comments is empty %}
        <p class="muted">Pas encore de commentaire.</p>
    {% else %}
        <div class="card">
            <ul class="plain">
                {% for c in topLevelComments %}
                    {% include 'post/_comment_item.html.twig' with { comment: c, level: 0 } only %}
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="card">
        <h2 style="margin-top:0">Ajouter un commentaire</h2>
        {% if replyTarget %}
            <p class="muted">
                Réponse à
                <strong>
                    {% if replyTarget.auteur %}{{ replyTarget.auteur.prenom }} {{ replyTarget.auteur.nom }}{% else %}Anonyme{% endif %}
                </strong>.
                <a href="{{ path('app_post_show', { id: post.id }) }}">Annuler la réponse</a>
            </p>
        {% endif %}
        {{ form_start(commentForm, { attr: { class: 'stack-form', id: 'comment-form', novalidate: 'novalidate' } }) }}
            <div class="emoji-btn-wrapper">
                {{ form_label(commentForm.contenu) }}
                <button type="button" class="emoji-trigger-btn" data-emoji-picker data-emoji-target="{{ commentForm.contenu.vars.id }}">
                    😊 <span>Emojis</span>
                </button>
            </div>
            {{ form_widget(commentForm.contenu) }}
            {{ form_errors(commentForm.contenu) }}
            <div class="stack-form-actions">
                <button type="submit" class="btn btn-primary">Publier</button>
            </div>
        {{ form_end(commentForm) }}
    </div>
{% endblock %}
