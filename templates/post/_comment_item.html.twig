<li{% if level > 0 %} style="margin-left: {{ level * 1.1 }}rem;"{% endif %}>
    <div>
        {% if comment.auteur %}<strong>{{ comment.auteur.prenom }} {{ comment.auteur.nom }}</strong>{% else %}Anonyme{% endif %}
        <span class="muted">({{ comment.auteurRole }}) · {{ comment.date|date('d/m/Y H:i') }}</span>
    </div>
    <div class="comment-body">{{ comment.contenu }}</div>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:.5rem;align-items:center">
        <span class="muted"><span id="comment-{{ comment.id }}" class="likes-count">{{ comment.nbLikes }}</span> j'aime</span>
        <button type="button" class="btn btn-link btn-sm like-btn" data-like-url="{{ path('app_comment_like', { id: comment.id }) }}" data-likes-counter="comment-{{ comment.id }}" style="padding: 0; text-decoration: none; color: inherit;">J'aime</button>
        {% if level < 4 %}
            <a href="{{ path('app_post_show', { id: comment.post.id, reply_to: comment.id }) }}">Répondre</a>
        {% endif %}
        
        {% if app.user and comment.auteur and app.user.id == comment.auteur.id %}
            <a href="{{ path('app_comment_edit', { id: comment.id }) }}" class="btn btn-link btn-sm" style="margin-left: auto; text-decoration: none;">✏️ Modifier</a>
            <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?');" style="display: inline-block;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                <button type="submit" class="btn btn-link btn-sm" style="color: #d32f2f; padding: 0; text-decoration: none;">🗑️ Supprimer</button>
            </form>
        {% elseif is_granted('ROLE_ADMIN') %}
            <form method="post" action="{{ path('app_admin_forum_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?');" style="display: inline-block; margin-left: auto;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                <button type="submit" class="btn btn-link btn-sm" style="color: #d32f2f; padding: 0; text-decoration: none;">🗑️ Supprimer (Admin)</button>
            </form>
        {% endif %}
    </div>
    {% if comment.replies is not empty %}
        <ul class="plain" style="margin-top:0.5rem">
            {% for child in comment.replies %}
                {% include 'post/_comment_item.html.twig' with { comment: child, level: level + 1 } only %}
            {% endfor %}
        </ul>
    {% endif %}
</li>
