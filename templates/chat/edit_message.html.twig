{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <div class="card mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white">Edit your message</div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Message Content</label>
                    <textarea name="message" class="form-control" rows="4" required>{{ message.contenuMessage }}</textarea>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_chat_view', {'userId': userId, 'id': message.conversation.id}) }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Update Message</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}