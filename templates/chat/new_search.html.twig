{% extends 'base.html.twig' %}

{% block body %}
<div class="wrap mt-4">
    <div class="dash-header mb-4">
        <div class="brand">
            <h1 class="brand-name">Start a New Conversation</h1>
            <span class="brand-tagline">Select a user to begin chatting</span>
        </div>
        <a href="{{ path('app_chat_inbox', {'userId': currentUser.id}) }}" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Cancel
        </a>
    </div>

    <div class="grid-2">
        {% for user in users %}
            <div class="entry-card d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center mb-3">
                    {# Generates a nice avatar circle using user initials #}
                    <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" 
                         style="width: 50px; height: 50px; background: var(--accent-soft); color: var(--accent); font-weight: 600; font-size: 1.2rem;">
                        {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                    </div>
                    <div class="ms-3 overflow-hidden">
                        <h3 class="mb-1 text-truncate" style="font-size: 1.15rem;">{{ user.prenom }} {{ user.nom }}</h3>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge">{{ user.role }}</span>
                            <small class="muted text-truncate">{{ user.email }}</small>
                        </div>
                    </div>
                </div>
                <div class="entry-card-cta mt-auto pt-2 border-top" style="border-color: var(--border) !important;">
                    <a href="{{ path('app_chat_create', {'userId': currentUser.id, 'recipientId': user.id}) }}" 
                       class="btn btn-primary w-100 text-center d-block">
                        <i class="fas fa-paper-plane me-2"></i> Start Conversation
                    </a>
                </div>
            </div>
        {% else %}
            <div class="empty-state" style="grid-column: 1 / -1;">
                <i class="fas fa-users mb-3" style="font-size: 2.5rem; color: var(--muted);"></i>
                <h3>No users available</h3>
                <p class="muted mb-0">There are no other users found to start a conversation with.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}