{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body_container %}
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <aside class="col-auto col-md-3 col-lg-2 min-vh-100 d-flex flex-column p-3 text-white sticky-top shadow" style="background: #34495e;">
                <div class="d-flex align-items-center mb-4 px-2">
                    <span class="fs-4 fw-bold text-uppercase letter-spacing-1">Espace Psy</span>
                </div>
                <hr class="mb-4 opacity-25">
                <ul class="nav nav-pills flex-column mb-auto gap-2">
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_dashboard') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_psychologue_dashboard' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span class="d-none d-md-inline">{{ 'nav.dashboard'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_planning_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_planning' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-calendar-days"></i>
                            <span class="d-none d-md-inline">{{ 'nav.planning'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_disponibilites_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_disponibilites' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-clock"></i>
                            <span class="d-none d-md-inline">{{ 'nav.availability'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_plans_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_plans' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-layer-group"></i>
                            <span class="d-none d-md-inline">{{ 'nav.plans'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_cabinets_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_cabinets' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-hospital"></i>
                            <span class="d-none d-md-inline">{{ 'nav.cabinets'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_programmes_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_programmes' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-leaf"></i>
                            <span class="d-none d-md-inline">{{ 'nav.programs'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_chat_inbox') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_messages' or app.request.get('_route') starts with 'app_chat' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-envelope"></i>
                            <span class="d-none d-md-inline">{{ 'nav.messages'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_consultation') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_consultation' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-comments"></i>
                            <span class="d-none d-md-inline">{{ 'nav.forum'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_statistiques') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_statistiques' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-chart-bar"></i>
                            <span class="d-none d-md-inline">{{ 'nav.statistics'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_calendar_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_calendar' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-calendar-days"></i>
                            <span class="d-none d-md-inline">{{ 'nav.calendar'|trans }}</span>
                        </a>
                    </li>
                </ul>
                <hr class="opacity-25 mt-4">
                <div class="dropdown p-2 mt-auto">
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                            {{ app.user.prenom|first }}{{ app.user.nom|first }}
                        </div>
                        <strong class="d-none d-md-inline">{{ app.user.prenom }}</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                        <li><a class="dropdown-item" href="{{ path('app_psychologue_account_pdf') }}" target="_blank" rel="noopener">Fiche compte (PDF)</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_account_profile') }}">Mon Profil</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="col ps-md-2 pt-2">
                <div class="bg-light min-vh-100 p-4 rounded-3 shadow-sm">
                    <!-- Top Bar in Content -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <h2 class="h4 mb-0 fw-bold">{% block psychologue_title %}Espace Psychologue{% endblock %}</h2>
                        <div class="d-flex align-items-center gap-4">
                            {% set weather = get_weather('Tunis') %}
                            {% if weather %}
                                <div class="weather-widget d-flex align-items-center gap-2 bg-white px-3 py-1 rounded-pill shadow-sm border">
                                    <img src="https://openweathermap.org/img/wn/{{ weather.icon }}.png" width="35" alt="meteo">
                                    <div class="d-flex flex-column" style="line-height: 1;">
                                        <span class="fw-bold" style="font-size: 0.9rem;">{{ weather.temp }}°C</span>
                                        <small class="text-muted" style="font-size: 0.7rem;">{{ weather.city }}</small>
                                    </div>
                                </div>
                            {% else %}
                                <small class="text-muted italic">{{ 'weather.unavailable'|trans }}</small>
                            {% endif %}

                            <div class="lang-switcher d-flex gap-1 bg-white p-1 rounded-pill border shadow-sm">
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'fr'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'fr' ? 'btn-primary' : 'btn-light' }}" title="Français">
                                    FR
                                </a>
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'en'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'en' ? 'btn-primary' : 'btn-light' }}" title="English">
                                    EN
                                </a>
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'ar'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'ar' ? 'btn-primary' : 'btn-light' }}" title="العربية">
                                    AR
                                </a>
                            </div>

                            <div class="text-muted small">
                                {{ "now"|date("d F Y") }}
                            </div>
                        </div>
                    </div>

                    {% block psychologue_body %}{% endblock %}
                </div>
            </main>
        </div>
    </div>
{% endblock %}
