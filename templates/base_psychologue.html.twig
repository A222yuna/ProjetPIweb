{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body_container %}
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <aside class="col-auto col-md-3 col-lg-2 min-vh-100 d-flex flex-column p-3 text-white sticky-top shadow" style="background: #34495e;">
                <div class="d-flex align-items-center mb-4 px-2">
                    <span class="fs-4 fw-bold text-uppercase letter-spacing-1">Espace Psy</span>
                </div>
                <hr class="mb-4 opacity-25">
                <ul class="nav nav-pills flex-column mb-auto gap-2">
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_dashboard') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_psychologue_dashboard' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span class="d-none d-md-inline">{{ 'nav.dashboard'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_calendar') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_psychologue_calendar' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span class="d-none d-md-inline">{{ 'nav.calendar'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_planning_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_planning' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-calendar-days"></i>
                            <span class="d-none d-md-inline">{{ 'nav.planning'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_disponibilites_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_disponibilites' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-clock"></i>
                            <span class="d-none d-md-inline">{{ 'nav.availability'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_plans_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_plans' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-layer-group"></i>
                            <span class="d-none d-md-inline">{{ 'nav.plans'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_cabinets_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_cabinets' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-hospital"></i>
                            <span class="d-none d-md-inline">{{ 'nav.cabinets'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_programmes_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_psychologue_programmes' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-leaf"></i>
                            <span class="d-none d-md-inline">{{ 'nav.programmes'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_statistiques') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_psychologue_statistiques' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-chart-line"></i>
                            <span class="d-none d-md-inline">Statistiques</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_messages_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_messages' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-envelope"></i>
                            <span class="d-none d-md-inline">{{ 'nav.messages'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_consultation') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_consultation' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-comments"></i>
                            <span class="d-none d-md-inline">{{ 'nav.forum'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_psychologue_profile_photo') }}" class="nav-link d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_psychologue_profile_photo' ? 'active bg-primary text-white' : (app.user.photoProfil is null ? 'text-warning fw-semibold' : 'text-white') }}">
                            <i class="fa-solid fa-camera"></i>
                            <span class="d-none d-md-inline">
                                Photo de profil
                                {% if app.user.photoProfil is null %}
                                    <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;">!</span>
                                {% endif %}
                            </span>
                        </a>
                    </li>
                </ul>
                <hr class="opacity-25 mt-4">
                <div class="dropdown p-2 mt-auto">
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                            {{ app.user.prenom|first }}{{ app.user.nom|first }}
                        </div>
                        <strong class="d-none d-md-inline">{{ app.user.prenom }}</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                        <li><a class="dropdown-item" href="{{ path('app_account_profile') }}">{{ 'nav.profile'|trans }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout', {'_locale': app.request.locale}) }}">{{ 'nav.logout'|trans }}</a></li>
                    </ul>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="col ps-md-2 pt-2">
                <div class="bg-light min-vh-100 p-4 rounded-3 shadow-sm">
                    <!-- Top Bar in Content -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <h2 class="h4 mb-0 fw-bold">{% block psychologue_title %}{{ 'nav.dashboard'|trans }}{% endblock %}</h2>
                        <div class="d-flex align-items-center gap-4">
                            <!-- Lang Switcher -->
                            <div class="lang-switcher d-flex gap-1 bg-white p-1 rounded-pill shadow-sm border">
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'fr'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'fr' ? 'btn-primary' : 'btn-outline-secondary border-0' }}">
                                   FR
                                </a>
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'en'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'en' ? 'btn-primary' : 'btn-outline-secondary border-0' }}">
                                   EN
                                </a>
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'ar'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'ar' ? 'btn-primary' : 'btn-outline-secondary border-0' }}">
                                   AR
                                </a>
                            </div>

                            {% set weather = weather_service.getWeather('Tunis') %}
                            {% if weather %}
                                <div class="weather-widget d-flex align-items-center gap-2 bg-white px-3 py-1 rounded-pill shadow-sm border">
                                    <img src="https://openweathermap.org/img/wn/{{ weather.icon }}.png" width="30" alt="meteo">
                                    <span class="fw-bold">{{ weather.temp }}°C</span>
                                    <small class="text-muted d-none d-sm-inline">{{ weather.city }}</small>
                                </div>
                            {% else %}
                                <div class="weather-widget d-flex align-items-center gap-2 text-muted small">
                                    <i class="fa-solid fa-cloud-sun"></i>
                                    <span>{{ 'weather.unavailable'|trans }}</span>
                                </div>
                            {% endif %}
                            <div class="text-muted small">
                                {{ 'user.welcome'|trans }}, {{ app.user.prenom }}
                            </div>
                        </div>
                    </div>

                    {# ── Photo de profil manquante ── #}
                    {% if app.user and app.user.photoProfil is null and app.request.get('_route') != 'app_psychologue_profile_photo' %}
                        <div class="alert alert-warning d-flex align-items-center gap-3 mb-4 rounded-3 shadow-sm" role="alert">
                            <i class="fa-solid fa-triangle-exclamation fa-lg flex-shrink-0"></i>
                            <div class="flex-grow-1">
                                <strong>Photo de profil manquante.</strong>
                                Elle est requise pour confirmer vos rendez-vous via la vérification faciale.
                            </div>
                            <a href="{{ path('app_psychologue_profile_photo') }}" class="btn btn-warning btn-sm fw-semibold text-nowrap">
                                <i class="fa-solid fa-camera me-1"></i> Ajouter ma photo
                            </a>
                        </div>
                    {% endif %}

                    {% block psychologue_body %}{% endblock %}
                </div>
            </main>
        </div>
    </div>
{% endblock %}
