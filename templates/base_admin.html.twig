{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body_container %}
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <aside class="col-auto col-md-3 col-lg-2 min-vh-100 d-flex flex-column p-3 text-white sticky-top shadow" style="background: #2c3e50;">
                <div class="d-flex align-items-center mb-4 px-2">
                    <span class="fs-4 fw-bold text-uppercase letter-spacing-1">Admin Panel</span>
                </div>
                <hr class="mb-4 opacity-25">
                <ul class="nav nav-pills flex-column mb-auto gap-2">
                    <li class="nav-item">
                        <a href="{{ path('app_admin_dashboard') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') == 'app_admin_dashboard' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span class="d-none d-md-inline">{{ 'nav.dashboard'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_users_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_admin_users' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-users"></i>
                            <span class="d-none d-md-inline">{{ 'user.role'|trans }}s</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_appointments_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_admin_appointments' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span class="d-none d-md-inline">{{ 'nav.appointments'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_cabinets_index') }}" class="nav-link text-white d-flex align-items-center gap-3 p-2 rounded {{ app.request.get('_route') starts with 'app_admin_cabinets' ? 'active bg-primary' : '' }}">
                            <i class="fa-solid fa-hospital"></i>
                            <span class="d-none d-md-inline">{{ 'nav.cabinets'|trans }}</span>
                        </a>
                    </li>
                    <!-- Add more admin routes as needed -->
                </ul>
                <hr class="opacity-25 mt-4">
                <div class="dropdown p-2 mt-auto">
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                            {{ app.user.prenom|first }}{{ app.user.nom|first }}
                        </div>
                        <strong class="d-none d-md-inline">{{ app.user.prenom }}</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                        <li><a class="dropdown-item" href="{{ path('app_account_profile') }}">{{ 'nav.profile'|trans }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout', {'_locale': app.request.locale}) }}">{{ 'nav.logout'|trans }}</a></li>
                    </ul>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="col ps-md-2 pt-2">
                <div class="bg-light min-vh-100 p-4 rounded-3 shadow-sm">
                    <!-- Top Bar in Content -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <h2 class="h4 mb-0 fw-bold">{% block admin_title %}Administration{% endblock %}</h2>
                        <div class="d-flex align-items-center gap-4">
                            <!-- Lang Switcher -->
                            <div class="lang-switcher d-flex gap-1 bg-white p-1 rounded-pill shadow-sm border">
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'fr'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'fr' ? 'btn-primary' : 'btn-outline-secondary border-0' }}">
                                   FR
                                </a>
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'en'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'en' ? 'btn-primary' : 'btn-outline-secondary border-0' }}">
                                   EN
                                </a>
                                <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'ar'})) }}" 
                                   class="btn btn-sm py-0 px-2 rounded-pill {{ app.request.locale == 'ar' ? 'btn-primary' : 'btn-outline-secondary border-0' }}">
                                   AR
                                </a>
                            </div>

                            <div class="text-muted small">
                                {{ 'user.welcome'|trans }}, {{ app.user.prenom }}
                            </div>
                        </div>
                    </div>

                    {% block admin_body %}{% endblock %}
                </div>
            </main>
        </div>
    </div>
{% endblock %}
