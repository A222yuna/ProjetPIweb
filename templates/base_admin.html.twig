{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-lg-2 min-vh-100 p-3" style="background:#7C6BA0;color:#F8F6FF">
                <h5 class="mb-4">Back Office Admin</h5>
                <ul class="nav flex-column gap-2">
                    <li><a class="nav-link text-white" href="{{ path('app_admin_module_comptes') }}"><i class="fa-solid fa-users me-2"></i>Comptes</a></li>
                    <li><a class="nav-link text-white" href="{{ path('app_admin_module_consultations') }}"><i class="fa-solid fa-calendar-check me-2"></i>Consultations</a></li>
                    <li><a class="nav-link text-white" href="{{ path('app_admin_module_cabinets') }}"><i class="fa-solid fa-hospital me-2"></i>Cabinets</a></li>
                    <li><a class="nav-link text-white" href="{{ path('app_admin_module_bienetre') }}"><i class="fa-solid fa-heart me-2"></i>Bien-etre</a></li>
                    <li><a class="nav-link text-white" href="{{ path('app_admin_module_messages') }}"><i class="fa-solid fa-envelope me-2"></i>Messages</a></li>
                    <li><a class="nav-link text-white" href="{{ path('app_admin_module_forum') }}"><i class="fa-solid fa-comments me-2"></i>Forum</a></li>
                    <li><a class="nav-link text-white" href="{{ path('app_admin_forum_reports') }}"><i class="fa-solid fa-flag me-2"></i>Signalements</a></li>
                </ul>
            </aside>
            <section class="col-md-9 col-lg-10 p-0" style="background:#F8F6FF">
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom bg-white">
                    <div><strong>{{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : 'Invite' }}</strong> - {{ app.user ? app.user.role : 'Anonyme' }}</div>
                    <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-secondary">Logout</a>
                </div>
                <div class="p-4">{% block admin_body %}{% endblock %}</div>
            </section>
        </div>
    </div>
{% endblock %}
