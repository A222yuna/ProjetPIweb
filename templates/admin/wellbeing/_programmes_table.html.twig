<div class="card p-0 overflow-auto">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Programme</th>
                <th>Psychologue</th>
                <th>Statut</th>
                <th>Niveau</th>
                <th>Activites</th>
                <th>Avis</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for p in programmes %}
                <tr>
                    <td>{{ p.id }}</td>
                    <td>
                        <strong>{{ p.nom }}</strong>
                        {% set objectif = p.objectif|default('Sans objectif') %}
                        <div class="small text-muted">{{ objectif|length > 90 ? objectif|slice(0, 90) ~ '...' : objectif }}</div>
                    </td>
                    <td>{{ p.psychologue ? p.psychologue.prenom ~ ' ' ~ p.psychologue.nom : 'N/A' }}</td>
                    <td><span class="badge bg-secondary">{{ p.statut|default('N/A') }}</span></td>
                    <td>{{ p.niveauDifficulte|default('N/A') }}</td>
                    <td>{{ p.activites|length }}</td>
                    <td>{{ p.avis|length }}</td>
                    <td class="text-end">
                        <form method="post" action="{{ path('app_admin_wellbeing_programme_delete', {id: p.id}) }}" onsubmit="return confirm('Supprimer ce programme et ses elements associes ?');" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_programme_' ~ p.id) }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-center text-muted py-4">Aucun programme trouve.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<div class="mt-3 d-flex justify-content-center">
    {{ knp_pagination_render(programmes) }}
</div>