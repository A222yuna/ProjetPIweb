{% extends 'base_admin.html.twig' %}

{% block title %}Admin - Utilisateurs{% endblock %}

{% block admin_body %}
    <h1 class="h4 mb-3">Gestion des comptes</h1>
    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Total comptes</small><div class="h5 mb-0">{{ users|length }}</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Filtre role</small><div class="h6 mb-0">{{ role_filter ?: 'Tous' }}</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Filtre actif</small><div class="h6 mb-0">{{ active_filter is same as('1') ? 'Oui' : (active_filter is same as('0') ? 'Non' : 'Tous') }}</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Page</small><div class="h6 mb-0">{{ page }}/{{ total_pages }}</div></div></div>
    </div>
    <form method="get" class="mb-3 d-flex gap-2 align-items-end">
        <div>
            <label class="form-label" for="role-filter">Role</label>
            <select id="role-filter" class="form-select form-select-sm" name="role">
                <option value="">Tous</option>
                <option value="Admin" {% if role_filter == 'Admin' %}selected{% endif %}>Admin</option>
                <option value="Psychologue" {% if role_filter == 'Psychologue' %}selected{% endif %}>Psychologue</option>
                <option value="Patient" {% if role_filter == 'Patient' %}selected{% endif %}>Patient</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="active-filter">Actif</label>
            <select id="active-filter" class="form-select form-select-sm" name="active">
                <option value="">Tous</option>
                <option value="1" {% if active_filter == '1' %}selected{% endif %}>Oui</option>
                <option value="0" {% if active_filter == '0' %}selected{% endif %}>Non</option>
            </select>
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Filtrer</button>
    </form>

    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Actif</th>
                        <th>Email verifie</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for u in users %}
                    <tr>
                        <td><strong>{{ u.prenom }} {{ u.nom }}</strong></td>
                        <td>{{ u.role }}</td>
                        <td>{{ u.email }}</td>
                        <td>{% if u.estActif %}<span class="badge text-bg-success">Oui</span>{% else %}<span class="badge text-bg-secondary">Non</span>{% endif %}</td>
                        <td>{% if u.emailVerifie %}<span class="badge text-bg-success">Oui</span>{% else %}<span class="badge text-bg-warning">Non</span>{% endif %}</td>
                        <td>
                            <form method="post" action="{{ path('app_admin_users_toggle_active', { id: u.id }) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_active_' ~ u.id) }}">
                                <button class="btn btn-sm btn-outline-warning" type="submit">Activer/Desactiver</button>
                            </form>
                            <form method="post" action="{{ path('app_admin_users_toggle_verified', { id: u.id }) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_verified_' ~ u.id) }}">
                                <button class="btn btn-sm btn-outline-info" type="submit">Verifier email</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">Aucun utilisateur.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if total_pages > 1 %}
        <div class="mt-3 d-flex gap-2 flex-wrap">
            {% for p in 1..total_pages %}
                <a class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-outline-primary' }}"
                   href="{{ path('app_admin_users_index', { page: p, role: role_filter, active: active_filter }) }}">{{ p }}</a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
