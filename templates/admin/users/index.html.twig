{% extends 'base_admin.html.twig' %}

{% block title %}Admin - Utilisateurs{% endblock %}

{% block admin_title %}Gestion des comptes{% endblock %}

{% block admin_body %}
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <small class="text-muted text-uppercase fw-bold ls-1 small">Total comptes</small>
                <div class="h4 mb-0 fw-bold text-primary">{{ users|length }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <small class="text-muted text-uppercase fw-bold ls-1 small">Filtre role</small>
                <div class="h5 mb-0 fw-bold">{{ role_filter ?: 'Tous' }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <small class="text-muted text-uppercase fw-bold ls-1 small">Filtre actif</small>
                <div class="h5 mb-0 fw-bold">{{ active_filter is same as('1') ? 'Oui' : (active_filter is same as('0') ? 'Non' : 'Tous') }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <small class="text-muted text-uppercase fw-bold ls-1 small">Page</small>
                <div class="h5 mb-0 fw-bold text-success">{{ page }} / {{ total_pages }}</div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <form method="get" action="{{ path('app_admin_users_index') }}" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted text-uppercase ls-1" for="q-search">Rechercher</label>
                <div class="input-group rounded-pill overflow-hidden border">
                    <span class="input-group-text border-0 bg-white ps-3">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" id="q-search" name="q" value="{{ search_term }}" class="form-control border-0 p-2" placeholder="Nom, prénom ou email...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase ls-1" for="role-filter">Role</label>
                <select id="role-filter" class="form-select rounded-pill border p-2" name="role">
                    <option value="">Tous les rôles</option>
                    <option value="Admin" {% if role_filter == 'Admin' %}selected{% endif %}>Admin</option>
                    <option value="Psychologue" {% if role_filter == 'Psychologue' %}selected{% endif %}>Psychologue</option>
                    <option value="Patient" {% if role_filter == 'Patient' %}selected{% endif %}>Patient</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase ls-1" for="active-filter">Statut Actif</label>
                <select id="active-filter" class="form-select rounded-pill border p-2" name="active">
                    <option value="">Tous les statuts</option>
                    <option value="1" {% if active_filter == '1' %}selected{% endif %}>Actif (Oui)</option>
                    <option value="0" {% if active_filter == '0' %}selected{% endif %}>Inactif (Non)</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary rounded-pill fw-bold p-2 shadow-sm">
                    <i class="fa-solid fa-filter me-1"></i> Filtrer
                </button>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle border-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0 rounded-start">Utilisateur</th>
                        <th class="border-0">Role</th>
                        <th class="border-0">Email</th>
                        <th class="border-0">Statut</th>
                        <th class="border-0">Vérifié</th>
                        <th class="border-0 rounded-end text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for u in users %}
                    <tr>
                        <td>
                            <div class="fw-bold">{{ u.prenom }} {{ u.nom }}</div>
                            <div class="small text-muted">Inscrit le {{ u.dateInscription ? u.dateInscription|date('d/m/Y') : '-' }}</div>
                        </td>
                        <td>
                            <span class="badge rounded-pill {% if u.role == 'Admin' %}bg-dark{% elseif u.role == 'Psychologue' %}bg-primary{% else %}bg-info text-dark{% endif %}">
                                {{ u.role }}
                            </span>
                        </td>
                        <td>{{ u.email }}</td>
                        <td>
                            {% if u.estActif %}
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Actif</span>
                            {% else %}
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if u.emailVerifie %}
                                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                            {% else %}
                                <i class="fa-solid fa-circle-xmark text-warning fs-5"></i>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-white border rounded-circle shadow-sm" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                    <li>
                                        <form method="post" action="{{ path('app_admin_users_toggle_active', { id: u.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_active_' ~ u.id) }}">
                                            <button class="dropdown-item d-flex align-items-center gap-2" type="submit">
                                                <i class="fa-solid fa-power-off text-warning"></i>
                                                {% if u.estActif %}Désactiver{% else %}Activer{% endif %}
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form method="post" action="{{ path('app_admin_users_toggle_verified', { id: u.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_verified_' ~ u.id) }}">
                                            <button class="dropdown-item d-flex align-items-center gap-2" type="submit">
                                                <i class="fa-solid fa-envelope-circle-check text-info"></i>
                                                Toggle vérification
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center py-5 text-muted">Aucun utilisateur trouvé.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if total_pages > 1 %}
        <nav class="mt-4">
            <ul class="pagination pagination-sm justify-content-center gap-2 border-0">
                {% for p in 1..total_pages %}
                    <li class="page-item {{ p == page ? 'active' : '' }}">
                        <a class="page-link rounded-circle border shadow-sm d-flex align-items-center justify-content-center" 
                           style="width: 35px; height: 35px;"
                           href="{{ path('app_admin_users_index', { page: p, role: role_filter, active: active_filter, q: search_term }) }}">{{ p }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
