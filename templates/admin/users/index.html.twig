{% extends 'base_admin.html.twig' %}

{% block title %}Admin - Utilisateurs{% endblock %}

{% block admin_title %}Gestion des comptes{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 mb-0">Gestion des comptes</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_admin_statistics') }}" class="btn btn-primary rounded-pill">
                <i class="fa-solid fa-chart-pie me-2"></i>Statistiques
            </a>
            <a href="{{ path('app_admin_users_connections') }}" class="btn btn-outline-primary rounded-pill">
                <i class="fa-solid fa-clock-rotate-left me-2"></i>Historique des connexions
            </a>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <form method="get" id="users-filter-form" action="{{ path('app_admin_users_index') }}" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted text-uppercase ls-1" for="q-search">Rechercher</label>
                <div class="input-group rounded-pill overflow-hidden border">
                    <span class="input-group-text border-0 bg-white ps-3">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" id="q-search" name="q" value="{{ search_term }}" class="form-control border-0 p-2" placeholder="Nom, prénom ou email...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase ls-1" for="role-filter">Role</label>
                <select id="role-filter" class="form-select rounded-pill border p-2" name="role">
                    <option value="">Tous les rôles</option>
                    <option value="Admin" {% if role_filter == 'Admin' %}selected{% endif %}>Admin</option>
                    <option value="Psychologue" {% if role_filter == 'Psychologue' %}selected{% endif %}>Psychologue</option>
                    <option value="Patient" {% if role_filter == 'Patient' %}selected{% endif %}>Patient</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase ls-1" for="active-filter">Statut</label>
                <select id="active-filter" class="form-select rounded-pill border p-2" name="active">
                    <option value="">Tous les statuts</option>
                    <option value="1" {% if active_filter == '1' %}selected{% endif %}>Actif</option>
                    <option value="0" {% if active_filter == '0' %}selected{% endif %}>Bloqué</option>
                </select>
            </div>
        </form>
    </div>

    <div id="users-results">
        {% include 'admin/users/_results.html.twig' with {
            users: users,
            role_filter: role_filter,
            active_filter: active_filter,
            search_term: search_term
        } only %}
    </div>

    <!-- AI Report Modal -->
    <div class="modal fade" id="aiReportModal" tabindex="-1" aria-labelledby="aiReportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="aiReportModalLabel">
                        <i class="fa-solid fa-robot text-primary"></i>
                        Analyse IA : <span id="ai-user-name"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div id="ai-report-content" class="p-3 bg-light rounded-3" style="min-height: 200px; white-space: pre-line;">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Chargement...</span>
                            </div>
                            <p class="mt-2 text-muted">L'IA analyse le profil, veuillez patienter...</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Fermer</button>
                    <a id="ai-validate-btn" href="#" class="btn btn-success rounded-pill px-4">
                        Valider ce psychologue
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const initAiReport = () => {
            const modal = document.getElementById('aiReportModal');
            if (!modal) return;

            const nameSpan = document.getElementById('ai-user-name');
            const contentDiv = document.getElementById('ai-report-content');
            const validateBtn = document.getElementById('ai-validate-btn');

            document.querySelectorAll('.ai-report-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const userId = this.dataset.userId;
                    const userName = this.dataset.userName;

                    nameSpan.textContent = userName;
                    contentDiv.innerHTML = `
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Chargement...</span>
                            </div>
                            <p class="mt-2 text-muted">L'IA analyse le profil, veuillez patienter...</p>
                        </div>
                    `;

                    // Hide validate button initially
                    validateBtn.style.display = 'none';

                    fetch(`/admin/users/${userId}/ai-report`)
                        .then(response => response.json())
                        .then(data => {
                            contentDiv.textContent = data.report;

                            // Setup validation button
                            validateBtn.style.display = 'inline-block';
                            // Note: We'll use the toggle_active route which also validates psychologues
                            validateBtn.onclick = function(e) {
                                e.preventDefault();
                                const form = document.createElement('form');
                                form.method = 'POST';
                                form.action = `/admin/users/${userId}/toggle-active`;

                                // We need the CSRF token. We can try to find it in the page's existing forms
                                const existingForm = document.querySelector(`form[action="/admin/users/${userId}/toggle-active"]`);
                                if (existingForm) {
                                    const tokenInput = existingForm.querySelector('input[name="_token"]');
                                    if (tokenInput) {
                                        const newTokenInput = document.createElement('input');
                                        newTokenInput.type = 'hidden';
                                        newTokenInput.name = '_token';
                                        newTokenInput.value = tokenInput.value;
                                        form.appendChild(newTokenInput);
                                    }
                                }

                                document.body.appendChild(form);
                                form.submit();
                            };
                        })
                        .catch(error => {
                            contentDiv.innerHTML = `<div class="alert alert-danger">Erreur lors de la génération du rapport.</div>`;
                        });
                });
            });
        };

        const initUsersAjaxFilter = () => {
            const form = document.getElementById('users-filter-form');
            const results = document.getElementById('users-results');
            if (!form || !results) {
                return;
            }
            if (form.dataset.ajaxBound === '1') {
                return;
            }
            form.dataset.ajaxBound = '1';

            let debounceTimer = null;
            let controller = null;

            const buildQuery = (extra = {}) => {
                const params = new URLSearchParams(new FormData(form));
                Object.entries(extra).forEach(([key, value]) => {
                    if (value === null || value === undefined || value === '') {
                        params.delete(key);
                    } else {
                        params.set(key, value);
                    }
                });
                return params.toString();
            };

            const loadResults = (extra = {}) => {
                if (controller) {
                    controller.abort();
                }
                controller = new AbortController();
                const query = buildQuery(extra);
                const url = `${form.action}?${query}`;

                fetch(url, {
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                    signal: controller.signal
                })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error('Failed to load users');
                    }
                    return response.text();
                })
                .then((html) => {
                    results.innerHTML = html;
                    history.replaceState({}, '', url);
                    initAiReport(); // Re-initialize buttons after AJAX load
                })
                .catch((error) => {
                    if (error.name !== 'AbortError') {
                        console.error(error);
                    }
                });
            };

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                loadResults({page: 1});
            });

            form.addEventListener('input', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement) || target.name !== 'q') {
                    return;
                }
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => loadResults({page: 1}), 300);
            });

            form.addEventListener('change', () => loadResults({page: 1}));

            results.addEventListener('click', (event) => {
                const link = event.target.closest('a.page-link');
                if (!(link instanceof HTMLAnchorElement)) {
                    return;
                }
                event.preventDefault();
                const url = new URL(link.href);
                const page = url.searchParams.get('page') || '1';
                loadResults({page});
            });

            results.addEventListener('DOMNodeInserted', () => {
                initAiReport();
            });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                initAiReport();
                initUsersAjaxFilter();
            });
        } else {
            initAiReport();
            initUsersAjaxFilter();
        }
        document.addEventListener('turbo:load', () => {
            initAiReport();
            initUsersAjaxFilter();
        });
    </script>
{% endblock %}
