{% extends 'base_admin.html.twig' %}

{% block title %}Statistiques - Admin{% endblock %}

{% block admin_title %}Statistiques & Analyses{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-end mb-4 gap-2">
        <!-- Bouton Modal Google Sheets -->
        <button type="button" class="btn btn-primary rounded-pill d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#googleSheetsModal">
            <i class="fa-brands fa-google-drive"></i>
            Exporter vers Google Sheets
        </button>

        <a href="{{ path('app_admin_statistics_export') }}" class="btn btn-success rounded-pill d-flex align-items-center gap-2">
            <i class="fa-solid fa-file-export"></i>
            Exporter en CSV (Excel)
        </a>
    </div>

    <!-- Modal Google Sheets -->
    <div class="modal fade" id="googleSheetsModal" tabindex="-1" aria-labelledby="googleSheetsModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="{{ path('app_admin_statistics_export_google') }}" method="POST">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold" id="googleSheetsModalLabel">Exporter vers Google Sheets</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-4">Entrez vos identifiants API Google pour envoyer les statistiques directement vers votre feuille de calcul.</p>
                        
                        <div class="mb-3">
                            <label for="spreadsheet_id" class="form-label fw-bold small text-uppercase ls-1">Spreadsheet ID</label>
                            <input type="text" class="form-control rounded-pill" id="spreadsheet_id" name="spreadsheet_id" placeholder="Ex: 1X2y3Z..." required>
                            <div class="form-text small">L'ID se trouve dans l'URL de votre feuille Google Sheets.</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="access_token" class="form-label fw-bold small text-uppercase ls-1">OAuth Access Token</label>
                            <input type="password" class="form-control rounded-pill" id="access_token" name="access_token" placeholder="Votre Bearer Token" required>
                            <div class="form-text small">Générez un jeton via Google OAuth2 Playground.</div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Lancer l'exportation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Distribution par Rôle -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-users-gear text-primary"></i>
                        Utilisateurs par Rôle
                    </h5>
                    <a href="{{ path('app_admin_users_index') }}" class="btn btn-sm btn-light rounded-pill">Voir tout</a>
                </div>
                <div id="role_chart_div"></div>
            </div>
        </div>

        <!-- Statut des Comptes -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-check text-success"></i>
                        Statut des Comptes
                    </h5>
                    <a href="{{ path('app_admin_users_index') }}" class="btn btn-sm btn-light rounded-pill">Gérer</a>
                </div>
                <div id="status_chart_div"></div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a href="{{ path('app_admin_users_index') }}" class="btn btn-outline-secondary rounded-pill">
            <i class="fa-solid fa-arrow-left me-2"></i>Retour à la liste des utilisateurs
        </a>
    </div>

    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        {{ gc_draw([roleChart, statusChart], ['role_chart_div', 'status_chart_div']) }}
    </script>
{% endblock %}
