{% extends 'base_admin.html.twig' %}

{% block title %}Appointment #{{ appointment.id }}{% endblock %}

{% block admin_body %}
    <p class="mb-3"><a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_appointments_index') }}">← Retour</a></p>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Détail rendez-vous #{{ appointment.id }}</h1>
        <a href="{{ path('app_appointment_pdf', {id: appointment.id}) }}" class="btn btn-sm btn-outline-danger">
            <i class="fa-solid fa-file-pdf me-1"></i> Télécharger PDF
        </a>
    </div>

    <div class="card p-3">
        <dl class="row mb-0">
            <dt class="col-sm-3">Patient</dt>
            <dd class="col-sm-9">{{ appointment.patient ? appointment.patient.prenom ~ ' ' ~ appointment.patient.nom : '-' }}</dd>
            <dt class="col-sm-3">Psychologue</dt>
            <dd class="col-sm-9">{{ appointment.plan and appointment.plan.psychologue ? appointment.plan.psychologue.prenom ~ ' ' ~ appointment.plan.psychologue.nom : '-' }}</dd>
            <dt class="col-sm-3">Plan</dt>
            <dd class="col-sm-9">{{ appointment.plan ? appointment.plan.dayOfWeek ~ ' ' ~ appointment.plan.period : '-' }}</dd>
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">{{ appointment.createdAt ? appointment.createdAt|date('d/m/Y H:i') : '-' }}</dd>
            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9"><strong>{{ appointment.status }}</strong></dd>
        </dl>
    </div>
    <div class="card p-3 mt-3">
        <h2 class="h6">Mettre à jour le statut</h2>
        <form method="post" action="{{ path('app_admin_appointments_update_status', { id: appointment.id }) }}" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_' ~ appointment.id) }}">
            <select class="form-select form-select-sm" name="appointment_status[status]">
                <option value="SCHEDULED" {% if appointment.status == 'SCHEDULED' %}selected{% endif %}>SCHEDULED</option>
                <option value="COMPLETED" {% if appointment.status == 'COMPLETED' %}selected{% endif %}>COMPLETED</option>
                <option value="CANCELLED" {% if appointment.status == 'CANCELLED' %}selected{% endif %}>CANCELLED</option>
            </select>
            <button class="btn btn-sm btn-primary" type="submit">Enregistrer</button>
        </form>
    </div>
{% endblock %}

