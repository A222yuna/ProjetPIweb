{% extends 'base_admin.html.twig' %}

{% block title %}Admin - Rendez-vous{% endblock %}

{% block admin_body %}
    <h1 class="h4 mb-3">Vue globale des rendez-vous</h1>
    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Elements page</small><div class="h5 mb-0">{{ appointments|length }}</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Filtre statut</small><div class="h6 mb-0">{{ status_filter ?: 'Tous' }}</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Page</small><div class="h6 mb-0">{{ page }}/{{ total_pages }}</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Workflow</small><div class="h6 mb-0">SCHEDULED -> COMPLETED</div></div></div>
    </div>
    <form method="get" class="mb-3 d-flex gap-2 align-items-end">
        <div>
            <label class="form-label" for="status-filter">Statut</label>
            <select id="status-filter" name="status" class="form-select form-select-sm">
                <option value="">Tous</option>
                <option value="SCHEDULED" {% if status_filter == 'SCHEDULED' %}selected{% endif %}>SCHEDULED</option>
                <option value="COMPLETED" {% if status_filter == 'COMPLETED' %}selected{% endif %}>COMPLETED</option>
                <option value="CANCELLED" {% if status_filter == 'CANCELLED' %}selected{% endif %}>CANCELLED</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="date-filter">Date</label>
            <input id="date-filter" type="date" name="date" class="form-control form-control-sm" value="{{ date_filter|default('') }}">
        </div>
        <button class="btn btn-sm btn-primary" type="submit">Filtrer</button>
    </form>
    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>ID</th><th>Patient</th><th>Psychologue</th><th>Date</th><th>Statut</th><th>Actions</th></tr></thead>
                <tbody>
                {% for a in appointments %}
                    <tr>
                        <td>#{{ a.id }}</td>
                        <td>{{ a.patient ? a.patient.prenom ~ ' ' ~ a.patient.nom : 'Patient inconnu' }}</td>
                        <td>{{ a.plan and a.plan.psychologue ? a.plan.psychologue.prenom ~ ' ' ~ a.plan.psychologue.nom : '-' }}</td>
                        <td>{{ a.createdAt ? a.createdAt|date('d/m/Y') : '-' }}</td>
                        <td>
                            {% if a.status == 'SCHEDULED' %}<span class="badge text-bg-primary">SCHEDULED</span>{% endif %}
                            {% if a.status == 'COMPLETED' %}<span class="badge text-bg-success">COMPLETED</span>{% endif %}
                            {% if a.status == 'CANCELLED' %}<span class="badge text-bg-danger">CANCELLED</span>{% endif %}
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_appointments_show', { id: a.id }) }}">Voir</a>
                            <form method="post" action="{{ path('app_admin_appointments_update_status', { id: a.id }) }}" style="display:inline-flex;gap:.4rem;align-items:center">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_' ~ a.id) }}">
                                <select class="form-select form-select-sm" name="appointment_status[status]">
                                    <option value="SCHEDULED" {% if a.status == 'SCHEDULED' %}selected{% endif %}>SCHEDULED</option>
                                    <option value="COMPLETED" {% if a.status == 'COMPLETED' %}selected{% endif %}>COMPLETED</option>
                                    <option value="CANCELLED" {% if a.status == 'CANCELLED' %}selected{% endif %}>CANCELLED</option>
                                </select>
                                <button class="btn btn-sm btn-outline-primary" type="submit">MAJ</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">Aucun rendez-vous enregistre.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if total_pages > 1 %}
        <div class="mt-3 d-flex gap-2 flex-wrap">
            {% for p in 1..total_pages %}
                <a class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-outline-primary' }}"
                   href="{{ path('app_admin_appointments_index', { page: p, status: status_filter, date: date_filter|default('') }) }}">{{ p }}</a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
