{% extends 'base_admin.html.twig' %}

{% block title %}Gestion du Forum — Publications{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion du Forum : Publications</h1>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <input type="text" name="q" value="{{ q }}" placeholder="Rechercher par titre ou contenu..." class="form-control">
                </div>
                <div class="col-md-3">
                    <select name="sort" class="form-select">
                        <option value="recent" {{ sort == 'recent' ? 'selected' : '' }}>Plus récents</option>
                        <option value="likes" {{ sort == 'likes' ? 'selected' : '' }}>Plus aimés</option>
                        <option value="comments" {{ sort == 'comments' ? 'selected' : '' }}>Plus commentés</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">Filtrer</button>
                    {% if q or sort != 'recent' %}
                        <a href="{{ path('app_admin_module_forum') }}" class="btn btn-link">Réinitialiser</a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Titre</th>
                            <th>Auteur</th>
                            <th>Catégorie</th>
                            <th>Stats</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for post in posts %}
                            <tr>
                                <td>{{ post.date|date('d/m/Y H:i') }}</td>
                                <td>
                                    <a href="{{ path('app_post_show', {id: post.id}) }}" target="_blank" class="text-decoration-none">
                                        {{ post.titre|length > 50 ? post.titre|slice(0, 50) ~ '...' : post.titre }}
                                    </a>
                                </td>
                                <td>
                                    {% if post.auteur %}
                                        {{ post.auteur.prenom }} {{ post.auteur.nom }}
                                        <span class="badge bg-info text-dark">{{ post.auteurRole }}</span>
                                    {% else %}
                                        <span class="text-muted italic">Anonyme</span>
                                    {% endif %}
                                </td>
                                <td><span class="badge bg-secondary">{{ post.categorie }}</span></td>
                                <td>
                                    <span title="Likes" class="me-2">❤️ {{ post.nbLikes }}</span>
                                    <span title="Commentaires">💬 {{ post.commentaires|length }}</span>
                                </td>
                                <td>
                                    <form method="post" action="{{ path('app_admin_forum_post_delete', {id: post.id}) }}" onsubmit="return confirm('Supprimer définitivement cette publication et tous ses commentaires ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Aucune publication trouvée.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        
        {% if total_pages > 1 %}
            <div class="card-footer bg-white">
                <nav aria-label="Pagination">
                    <ul class="pagination pagination-sm mb-0 justify-content-center">
                        {% for p in 1..total_pages %}
                            <li class="page-item {{ p == page ? 'active' : '' }}">
                                <a class="page-link" href="{{ path('app_admin_module_forum', {page: p, q: q, sort: sort}) }}">{{ p }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
        {% endif %}
    </div>
{% endblock %}
