{% extends 'base_patient.html.twig' %}

{% block title %}Mon Calendrier{% endblock %}

{% block patient_title %}Mon Calendrier de Soins{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #calendar {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            min-height: 700px;
        }
        .fc-header-toolbar {
            margin-bottom: 2em !important;
        }
        .fc-button-primary {
            background-color: #1abc9c !important;
            border-color: #1abc9c !important;
        }
        .fc-button-active {
            background-color: #16a085 !important;
            border-color: #16a085 !important;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }
        .legend-color {
            width: 15px;
            height: 15px;
            border-radius: 3px;
        }
    </style>
{% endblock %}

{% block patient_body %}
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Mes rendez-vous à venir</h5>
            <div class="d-flex gap-3">
                <div class="legend-item"><div class="legend-color" style="background: #5B9BD5;"></div><span>Réservé</span></div>
                <div class="legend-item"><div class="legend-color" style="background: #e74c3c;"></div><span>Annulé</span></div>
            </div>
        </div>
        
        <div id="calendar"></div>
    </div>

    <!-- Modal Détails -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="eventTitle">Détails du rendez-vous</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                            <i class="fa-solid fa-user-doctor fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold" id="psyNameDisplay">-</h6>
                            <p class="text-muted small mb-0" id="cabinetNameDisplay">-</p>
                        </div>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1">Date & Heure</small>
                                <span class="fw-semibold" id="eventStartDisplay">-</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1">Statut</small>
                                <span class="badge rounded-pill" id="eventStatusDisplay">-</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1">Adresse</small>
                                <span class="fw-semibold" id="eventAddressDisplay">-</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
                    <a id="viewAppointmentBtn" href="#" class="btn btn-success text-white rounded-pill px-4">Mes rendez-vous</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var eventModal = new bootstrap.Modal(document.getElementById('eventModal'));
            
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
                },
                buttonText: {
                    today: 'Aujourd\'hui',
                    month: 'Mois',
                    week: 'Semaine',
                    day: 'Jour',
                    list: 'Liste'
                },
                events: '{{ path('app_patient_calendar_events') }}',
                loading: function(isLoading) {
                    if (!isLoading) {
                        console.log('Patient events loaded');
                    }
                },
                eventSourceSuccess: function(content, xhr) {
                    console.log('Successfully fetched patient events:', content);
                    return content;
                },
                eventSourceFailure: function(error) {
                    console.error('Error fetching patient events:', error);
                },
                eventClick: function(info) {
                    const props = info.event.extendedProps;
                    
                    document.getElementById('psyNameDisplay').textContent = info.event.title;
                    document.getElementById('cabinetNameDisplay').textContent = props.cabinet;
                    document.getElementById('eventStartDisplay').textContent = info.event.start.toLocaleString('fr-FR');
                    
                    const statusBadge = document.getElementById('eventStatusDisplay');
                    statusBadge.textContent = props.status;
                    statusBadge.className = 'badge rounded-pill ';
                    
                    if (props.status === 'RESERVE') statusBadge.classList.add('bg-primary');
                    else statusBadge.classList.add('bg-danger');
                    
                    document.getElementById('eventAddressDisplay').textContent = props.adresse;
                    document.getElementById('viewAppointmentBtn').href = "{{ path('app_patient_rendezvous_index') }}";
                    
                    eventModal.show();
                },
                eventMouseEnter: function(info) {
                    info.el.style.cursor = 'pointer';
                }
            });
            calendar.render();
        });
    </script>
{% endblock %}
