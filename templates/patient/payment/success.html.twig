{% extends 'base_patient.html.twig' %}

{% block title %}Paiement réussi{% endblock %}

{% block patient_title %}Confirmation de Paiement{% endblock %}

{% block patient_body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-5 mb-4">
                <div class="mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                        <i class="fa-solid fa-check fs-1 text-success"></i>
                    </div>
                    <h2 class="fw-bold text-success">Merci !</h2>
                    <p class="text-muted fs-5">Votre paiement a été effectué avec succès.</p>
                </div>

                <div class="bg-light rounded-4 p-4 mb-4">
                    <h6 class="fw-bold mb-3">Votre ticket d'accès (QR Code)</h6>
                    <div class="bg-white p-3 d-inline-block rounded-3 shadow-sm mb-3">
                        <img src="{{ qrCode }}" alt="QR Code de votre rendez-vous" class="img-fluid" style="max-width: 200px;">
                    </div>
                    <p class="small text-muted mb-0">Présentez ce code lors de votre consultation.</p>
                </div>

                <div class="d-grid gap-3">
                    <button onclick="window.print()" class="btn btn-outline-primary rounded-pill py-2">
                        <i class="fa-solid fa-download me-2"></i> Télécharger en PDF / Imprimer
                    </button>
                    <a href="{{ path('app_patient_calendar') }}" class="btn btn-primary rounded-pill py-2">
                        <i class="fa-solid fa-calendar-days me-2"></i> Voir mon calendrier
                    </a>
                </div>
            </div>

            <p class="text-muted small">
                Un email de confirmation avec votre reçu a été envoyé à votre adresse.
            </p>
        </div>
    </div>
</div>

<style>
    @media print {
        .btn, .sidebar, .header, .navbar { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
        .container { width: 100% !important; max-width: 100% !important; }
    }
</style>
{% endblock %}
