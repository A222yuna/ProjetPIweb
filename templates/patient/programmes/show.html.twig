{% extends 'base_patient.html.twig' %}

{% block title %}{{ programme.nom }}{% endblock %}
{% block patient_title %}{{ programme.nom }}{% endblock %}

{% block patient_body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="{{ path('app_patient_programmes_index') }}" class="btn btn-light rounded-pill">
        <i class="fa-solid fa-arrow-left me-2"></i>Retour
    </a>
    <div class="d-flex gap-2">
        <a href="{{ path('app_patient_programme_pdf', {id: programme.id}) }}" class="btn btn-outline-secondary rounded-pill" target="_blank">
            <i class="fa-solid fa-file-pdf me-1"></i>Télécharger PDF
        </a>
        <a href="{{ path('app_patient_avis_new', {id: programme.id}) }}" class="btn btn-primary rounded-pill">
            <i class="fa-solid fa-star me-1"></i>Laisser un avis
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-8">
            <h4 class="fw-bold">{{ programme.nom }}</h4>
            {% if programme.psychologue %}
                <p class="text-muted mb-2">Par Dr. {{ programme.psychologue.prenom }} {{ programme.psychologue.nom }}</p>
            {% endif %}
            <p>{{ programme.objectif }}</p>
            <div class="d-flex gap-3 flex-wrap">
                <span><i class="fa-solid fa-calendar-days me-1 text-primary"></i>{{ programme.duree }} jours</span>
                <span><i class="fa-solid fa-signal me-1 text-info"></i>{{ programme.niveauDifficulte ?? 'Non défini' }}</span>
                <span class="badge rounded-pill {% if programme.statut == 'actif' %}bg-success{% else %}bg-secondary{% endif %}">
                    {{ programme.statut ?? 'actif' }}
                </span>
            </div>
        </div>
        {% if programme.image %}
        <div class="col-md-4">
            <img src="{{ asset('uploads/programmes/' ~ programme.image) }}" class="img-fluid rounded-3" alt="{{ programme.nom }}">
        </div>
        {% endif %}
    </div>
</div>

<h5 class="fw-bold mb-3">Activités ({{ programme.activites|length }})</h5>

{% if programme.activites is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-muted">
        Aucune activité pour ce programme.
    </div>
{% else %}
    <div class="row g-3 mb-4">
        {% for a in programme.activites %}
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-primary rounded-pill">Jour {{ a.jour }}</span>
                    {% if a.typeActivite %}
                        <span class="badge bg-light text-dark border">{{ a.typeActivite }}</span>
                    {% endif %}
                </div>
                <h6 class="fw-bold mb-1">{{ a.titre }}</h6>
                {% if a.heureDebut %}
                    <p class="text-muted small mb-1"><i class="fa-solid fa-clock me-1"></i>{{ a.heureDebut|date('H:i') }}{% if a.dureeMinutes %} · {{ a.dureeMinutes }} min{% endif %}</p>
                {% endif %}
                {% if a.description %}
                    <p class="small text-muted mb-0">{{ a.description }}</p>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}

{% if programme.avis is defined and programme.avis|length > 0 %}
<h5 class="fw-bold mb-3">Avis ({{ programme.avis|length }})</h5>
<div class="card border-0 shadow-sm rounded-4 p-4">
    {% for avis in programme.avis %}
    <div class="{% if not loop.last %}border-bottom pb-3 mb-3{% endif %}">
        <div class="d-flex justify-content-between">
            <strong>{{ avis.patient ? avis.patient.prenom ~ ' ' ~ avis.patient.nom : 'Anonyme' }}</strong>
            <span>{% for i in 1..5 %}{{ i <= avis.note ? '⭐' : '☆' }}{% endfor %}</span>
        </div>
        <p class="text-muted small mb-0">{{ avis.commentaire }}</p>
        <small class="text-muted">{{ avis.dateAvis ? avis.dateAvis|date('d/m/Y') : '' }}</small>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
