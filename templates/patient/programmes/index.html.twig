{% extends 'base_patient.html.twig' %}

{% block title %}Programmes bien-être{% endblock %}
{% block patient_title %}Programmes bien-être{% endblock %}

{% block patient_body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-muted mb-0">Découvrez les programmes créés par nos psychologues.</p>
    <form method="GET" class="d-flex gap-2">
        <input type="text" name="q" value="{{ q }}" class="form-control rounded-pill" placeholder="Rechercher..." style="max-width:250px">
        <button type="submit" class="btn btn-primary rounded-pill">Rechercher</button>
    </form>
</div>

{% if programmes is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="mb-3" style="font-size:3rem">🧘</div>
        <h5 class="fw-bold">Aucun programme disponible</h5>
        <p class="text-muted">Revenez bientôt, de nouveaux programmes seront ajoutés.</p>
    </div>
{% else %}
    <div class="row g-4">
        {% for p in programmes %}
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                {% if p.image %}
                    <img src="{{ asset('uploads/programmes/' ~ p.image) }}" class="card-img-top rounded-top-4" style="height:160px;object-fit:cover" alt="{{ p.nom }}">
                {% else %}
                    <div class="rounded-top-4 d-flex align-items-center justify-content-center bg-light" style="height:100px;font-size:2.5rem">🧘</div>
                {% endif %}
                <div class="card-body">
                    <h5 class="fw-bold mb-1">{{ p.nom }}</h5>
                    <p class="text-muted small mb-2">
                        {{ p.duree }} jours · {{ p.niveauDifficulte ?? 'Moyen' }}
                        {% if p.psychologue %}· Dr. {{ p.psychologue.prenom }} {{ p.psychologue.nom }}{% endif %}
                    </p>
                    <p class="small mb-3">{{ p.objectif|length > 80 ? p.objectif|slice(0,80) ~ '...' : p.objectif }}</p>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="badge bg-light text-dark border">{{ p.activites|length }} activités</span>
                        <span class="badge bg-light text-dark border">{{ p.avis|length }} avis</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3 px-3">
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_patient_programme_show', {id: p.id}) }}" class="btn btn-sm btn-primary rounded-pill">Voir le programme</a>
                        <a href="{{ path('app_patient_programme_pdf', {id: p.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill" target="_blank">
                            <i class="fa-solid fa-file-pdf"></i> PDF
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
