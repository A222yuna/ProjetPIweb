{% extends 'base.html.twig' %}

{% block title %}Explorer les programmes de bien-être{% endblock %}

{% block body_attr %}class="layout-wide"{% endblock %}

{% block stylesheets %}
<style>
    body.layout-wide .wrap { max-width: 1500px !important; }

    .patient-hero {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 100%);
        border-radius: 20px;
        padding: 4rem 3rem;
        margin-bottom: 3rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(42, 111, 91, 0.2);
    }
    .patient-hero::before {
        content: ''; position: absolute; right: -50px; top: -50px;
        width: 300px; height: 300px; border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }
    .patient-hero h1 {
        font-family: var(--font-serif);
        font-size: 3rem; margin: 0 0 1rem;
        color: #fff; font-weight: 700;
    }
    .patient-hero p {
        font-size: 1.25rem; opacity: 0.9; max-width: 600px; margin: 0;
        line-height: 1.6;
    }

    .prog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 2rem;
    }
    .patient-flow {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: var(--shadow);
        padding: 1.25rem;
        margin-bottom: 2rem;
    }
    .patient-flow h2 {
        margin: 0 0 .85rem;
        font-size: 1.2rem;
    }
    .patient-flow-steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: .85rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .patient-flow-step {
        background: #faf9f7;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: .8rem .85rem;
        font-size: .9rem;
        color: var(--text);
    }
    .patient-flow-step strong {
        display: block;
        color: var(--accent);
        margin-bottom: .15rem;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .prog-card-modern {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
        display: flex; flex-direction: column;
        transition: all .3s cubic-bezier(.4,0,.2,1);
        box-shadow: var(--shadow);
    }
    .prog-card-modern:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.08);
        border-color: var(--accent);
    }

    .prog-visual {
        height: 200px; background-size: cover; background-position: center;
        position: relative;
    }
    .prog-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
    }
    .prog-tag {
        position: absolute; top: 1rem; right: 1rem;
        background: rgba(255,255,255,0.9); backdrop-filter: blur(8px);
        padding: .35rem .75rem; border-radius: 10px;
        font-size: .72rem; font-weight: 700; color: var(--accent);
        text-transform: uppercase;
    }

    .prog-content { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
    .prog-author {
        display: flex; align-items: center; gap: .5rem;
        font-size: .85rem; color: var(--muted); margin-bottom: .75rem;
    }
    .prog-author-avatar {
        width: 24px; height: 24px; border-radius: 50%;
        background: var(--accent-soft); display: flex; align-items: center; justify-content: center;
        font-weight: 600; font-size: .7rem; color: var(--accent);
    }

    .prog-content h2 {
        font-family: var(--font-serif); font-size: 1.4rem; margin: 0 0 .75rem;
        line-height: 1.25;
    }
    .prog-content h2 a { color: var(--text); }

    .prog-brief {
        font-size: .95rem; line-height: 1.6; color: var(--muted);
        margin-bottom: 1.25rem; flex: 1;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .prog-meta-row {
        display: flex; align-items: center; gap: 1rem;
        margin-bottom: 1.25rem; font-size: .88rem; font-weight: 500;
    }
    .prog-meta-item { display: flex; align-items: center; gap: .35rem; color: var(--text); }
    .prog-meta-item i { color: var(--accent); font-style: normal; font-size: 1.1rem; }

    .prog-footer {
        padding-top: 1.25rem; border-top: 1px solid var(--border);
        display: flex; justify-content: space-between; align-items: center;
    }
    .prog-rating { display: flex; align-items: center; gap: .35rem; }
    .stars-total { color: #e8a838; letter-spacing: 1px; font-size: .95rem; }
    .reviews-count { font-size: .78rem; color: var(--muted); font-weight: 600; }
    .prog-card-modern.is-featured {
        border-color: rgba(42, 111, 91, 0.35);
        box-shadow: 0 12px 32px rgba(42, 111, 91, 0.12);
    }
    .prog-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        margin-bottom: 1rem;
    }
    .prog-chip {
        font-size: .72rem;
        font-weight: 600;
        border-radius: 999px;
        padding: .2rem .55rem;
        border: 1px solid var(--border);
        color: var(--muted);
        background: #faf9f7;
    }
    .prog-chip--highlight {
        border-color: rgba(42, 111, 91, 0.25);
        color: var(--accent);
        background: var(--accent-soft);
    }

</style>
{% endblock %}

{% block body %}
<div class="patient-hero">
    <h1>Prenez soin de vous</h1>
    <p>Découvrez nos programmes d'accompagnement conçus par des experts pour votre bien-être mental et émotionnel.</p>
</div>

<section class="patient-flow">
    <h2>Votre parcours patient</h2>
    <ol class="patient-flow-steps">
        <li class="patient-flow-step">
            <strong>Etape 1</strong>
            Choisissez un programme selon votre objectif et votre niveau.
        </li>
        <li class="patient-flow-step">
            <strong>Etape 2</strong>
            Ouvrez le programme pour voir toutes les activites jour par jour.
        </li>
        <li class="patient-flow-step">
            <strong>Etape 3</strong>
            Suivez le planning, puis partagez votre avis pour aider la communaute.
        </li>
    </ol>
</section>

{% if programmes is empty %}
    <div class="empty-state">
        <div style="font-size:3rem;margin-bottom:1rem">🌱</div>
        <h3>Bientôt de nouveaux programmes</h3>
        <p class="muted">Nos psychologues préparent actuellement de nouveaux contenus pour vous.</p>
    </div>
{% else %}
    <div class="prog-grid">
        {% for p in programmes %}
            <div class="prog-card-modern {{ loop.first ? 'is-featured' : '' }}">
                {% if p.image %}
                    <div class="prog-visual" style="background-image:url('{{ asset('uploads/' ~ p.image) }}')">
                {% else %}
                    <div class="prog-visual" style="background:linear-gradient(135deg,#e6f0ec,#f0f4f2);display:flex;align-items:center;justify-content:center">
                        <span style="font-size:4rem">🌿</span>
                {% endif %}
                    <div class="prog-overlay"></div>
                    {% if p.niveauDifficulte %}
                        <span class="prog-tag">{{ p.niveauDifficulte }}</span>
                    {% endif %}
                </div>

                <div class="prog-content">
                    <div class="prog-chip-row">
                        {% if loop.first %}
                            <span class="prog-chip prog-chip--highlight">Recommande</span>
                        {% endif %}
                        <span class="prog-chip">{{ p.statut|default('Actif')|capitalize }}</span>
                    </div>
                    <div class="prog-author">
                        <div class="prog-author-avatar">{{ p.psychologue.prenom|slice(0,1)|upper }}</div>
                        <span>Dr. {{ p.psychologue.prenom }} {{ p.psychologue.nom }}</span>
                    </div>

                    <h2><a href="{{ path('app_patient_programme_show', {id: p.id}) }}">{{ p.nom }}</a></h2>
                    
                    <p class="prog-brief">{{ p.objectif|default('Améliorez votre bien-être avec ce programme structuré.') }}</p>

                    <div class="prog-meta-row">
                        <div class="prog-meta-item"><i>📅</i> {{ p.duree }} Jours</div>
                        <div class="prog-meta-item"><i>📝</i> {{ p.activites|length }} Activités</div>
                    </div>

                    <div class="prog-footer">
                        {% set totalNotes = 0 %}
                        {% for a in p.avis %}{% set totalNotes = totalNotes + a.note %}{% endfor %}
                        
                        <div class="prog-rating">
                            {% if p.avis|length > 0 %}
                                {% set avg = (totalNotes / p.avis|length)|round(1) %}
                                <span class="stars-total">
                                    {% for i in 1..5 %}{{ i <= avg|round(0, 'floor') ? '★' : '☆' }}{% endfor %}
                                </span>
                                <span class="reviews-count">({{ p.avis|length }})</span>
                            {% else %}
                                <span class="reviews-count" style="font-style:italic">Nouveau</span>
                            {% endif %}
                        </div>

                        <a href="{{ path('app_patient_programme_show', {id: p.id}) }}" class="btn btn-primary btn-sm">Explorer</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
