{% extends 'base_patient.html.twig' %}

{% block title %}Mes avis{% endblock %}
{% block patient_title %}Mes avis{% endblock %}

{% block patient_body %}
{% if avis_list is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="mb-3" style="font-size:3rem">⭐</div>
        <h5 class="fw-bold">Aucun avis publié</h5>
        <p class="text-muted">Consultez un programme et laissez votre premier avis.</p>
        <a href="{{ path('app_patient_programmes_index') }}" class="btn btn-primary rounded-pill px-4 mt-2">Voir les programmes</a>
    </div>
{% else %}
    <div class="card border-0 shadow-sm rounded-4 p-4">
        {% for a in avis_list %}
        <div class="{% if not loop.last %}border-bottom pb-3 mb-3{% endif %}">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <strong>{{ a.programme ? a.programme.nom : 'Programme supprimé' }}</strong>
                    <div>{% for i in 1..5 %}{{ i <= a.note ? '⭐' : '☆' }}{% endfor %}</div>
                    <p class="text-muted small mb-1">{{ a.commentaire }}</p>
                    <small class="text-muted">{{ a.dateAvis ? a.dateAvis|date('d/m/Y') : '' }}</small>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_patient_avis_edit', {id: a.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill">Modifier</a>
                    <form method="post" action="{{ path('app_patient_avis_delete', {id: a.id}) }}" onsubmit="return confirm('Supprimer cet avis ?')" style="display:inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
