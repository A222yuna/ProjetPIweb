{% extends 'base.html.twig' %}

{% block title %}Modifier mon avis — {{ programme.nom }}{% endblock %}

{% block stylesheets %}
<style>
    .form-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 12px 40px rgba(0,0,0,0.06);
        max-width: 800px;
        margin-bottom: 3rem;
    }
    .star-rating-container {
        display: flex;
        gap: .5rem;
        margin-bottom: 1rem;
    }
    .star-btn {
        font-size: 2.5rem;
        color: var(--border);
        cursor: pointer;
        transition: all .2s ease;
        background: none; border: none; padding: 0;
    }
    .star-btn.active, .star-btn:hover, .star-btn.hover {
        color: #e8a838;
        transform: scale(1.1);
    }
    .star-label {
        display: block; font-weight: 700; margin-bottom: .75rem; color: var(--text);
    }
    .hidden-select { display: none; }
</style>
{% endblock %}

{% block body %}
<a href="{{ path('app_patient_avis_index') }}" class="back-link">← Retour à mes avis</a>

<div class="page-eyebrow">Modifier mon avis</div>
<h1>Mettre à jour votre évaluation</h1>
<p class="page-lead">Vous pouvez ajuster votre note et votre commentaire pour le programme <strong>{{ programme.nom }}</strong>.</p>

<div class="form-card">
    {{ form_start(form, {'attr': {'class': 'stack-form', 'novalidate': 'novalidate', 'id': 'avis-form'}}) }}

    <div class="form-section">
        <label class="star-label">Nouvelle note :</label>
        <div class="star-rating-container" id="star-rating">
            {% for i in 1..5 %}
                <button type="button" class="star-btn" data-value="{{ i }}">★</button>
            {% endfor %}
        </div>
        <div class="hidden-select">
            {{ form_row(form.note) }}
        </div>
    </div>

    <div style="margin-top: 2rem;">
        {{ form_row(form.commentaire) }}
    </div>

    <div class="stack-form-actions" style="margin-top: 2.5rem;">
        <button type="submit" class="btn btn-primary btn-lg">💾 Enregistrer les modifications</button>
        <a href="{{ path('app_patient_avis_index') }}" class="btn btn-outline btn-lg">Annuler</a>
    </div>

    {{ form_end(form) }}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const starContainer = document.getElementById('star-rating');
    const stars = starContainer.querySelectorAll('.star-btn');
    const select = document.querySelector('#avis_note');
    
    updateStars(select.value || 1);

    stars.forEach(star => {
        star.addEventListener('click', function() {
            const val = this.getAttribute('data-value');
            select.value = val;
            updateStars(val);
        });
        star.addEventListener('mouseenter', function() {
            highlightStars(this.getAttribute('data-value'));
        });
        star.addEventListener('mouseleave', function() {
            updateStars(select.value);
        });
    });

    function updateStars(val) {
        stars.forEach(s => {
            s.classList.toggle('active', parseInt(s.getAttribute('data-value')) <= parseInt(val));
            s.classList.remove('hover');
        });
    }
    function highlightStars(val) {
        stars.forEach(s => {
            s.classList.toggle('hover', parseInt(s.getAttribute('data-value')) <= parseInt(val));
        });
    }
});
</script>
{% endblock %}
