<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body { font-family: Arial, sans-serif; background: #F4F6FB; margin: 0; padding: 20px; }
  .card { max-width: 560px; margin: 0 auto; background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.1); }
  .header { background: linear-gradient(135deg, #6B3FA0, #00BFA5); padding: 32px 40px; text-align: center; color: white; }
  .header h1 { font-size: 22px; margin: 0 0 6px; }
  .header p  { margin: 0; opacity: .85; font-size: 14px; }
  .body   { padding: 32px 40px; color: #1A1A2E; font-size: 14px; line-height: 1.6; }
  .row    { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #E5E7EB; }
  .label  { color: #6B7280; }
  .value  { font-weight: 600; }
  .btn    { display: block; text-align: center; background: #6B3FA0; color: white; padding: 14px 32px; border-radius: 10px; text-decoration: none; font-weight: 600; margin: 24px 0; }
  .footer { background: #F4F6FB; padding: 16px 40px; text-align: center; font-size: 12px; color: #9CA3AF; }
</style>
</head>
<body>
<div class="card">
  {% block content %}{% endblock %}
  <div class="footer">Cabinet de Psychologie — Ne pas répondre à cet email automatique</div>
</div>
</body>
</html>
