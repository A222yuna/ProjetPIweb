{% extends 'emails/base.html.twig' %}

{% block body %}
    <table width="100%" border="0" cellspacing="0" cellpadding="0">
        <tr>
            <td align="center">
                <div style="width: 80px; height: 80px; background-color: #ecfdf5; border-radius: 50%; display: inline-block; line-height: 80px; font-size: 40px; margin-bottom: 24px;">
                    🌱
                </div>
                <h1 class="h1" style="margin-bottom: 8px;">Bienvenue à bord !</h1>
                <p class="text" style="font-size: 18px; color: #6b7280;">Salut {{ user.prenom|default('l\'ami') }}, nous sommes ravis de vous voir.</p>
                
                <div style="height: 1px; background-color: #e5e7eb; width: 100px; margin: 32px auto;"></div>
                
                <p class="text" style="text-align: center;">
                    Vous venez de faire le premier pas vers une gestion intelligente et sereine de votre bien-être. Avec <strong>MindCare</strong>, tout est conçu pour vous simplifier la vie.
                </p>

                <div style="background-color: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 24px; margin: 32px 0; text-align: left;">
                    <p style="margin: 0 0 12px 0; font-weight: 700; color: #1e293b;">🚀 Prochaines étapes :</p>
                    <ul style="margin: 0; padding-left: 20px; color: #475569; font-size: 14px; line-height: 22px;">
                        <li>Personnalisez votre profil utilisateur</li>
                        <li>Explorez les programmes de bien-être disponibles</li>
                        <li>Planifiez votre première séance d'activité</li>
                    </ul>
                </div>

                <div style="margin-top: 40px;">
                    <a href="{{ url('app_home') }}" class="btn" style="width: 280px; background: linear-gradient(135deg, #059669 0%, #10b981 100%);">Démarrer l'aventure</a>
                </div>

                <p class="text" style="margin-top: 40px; font-size: 14px; color: #9ca3af;">
                    Besoin d'aide ? Notre équipe est disponible 24/7 pour vous accompagner.
                </p>
            </td>
        </tr>
    </table>
{% endblock %}
