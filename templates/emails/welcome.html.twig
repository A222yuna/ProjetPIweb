{% extends 'emails/base.html.twig' %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
        <td align="left">
            <div style="display:inline-block;background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;font-size:12px;font-weight:700;padding:6px 10px;border-radius:999px;margin-bottom:16px;">
                BIENVENUE SUR MINDCARE
            </div>

            <h1 class="h1" style="margin-bottom:10px;">Bienvenue {{ user.prenom|default('cher utilisateur') }} !</h1>
            <p class="text" style="margin-bottom:20px;">
                Votre compte est prêt. Vous pouvez maintenant découvrir des programmes bien-être,
                suivre vos activités et garder un rythme régulier avec des conseils personnalisés.
            </p>

            <div style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:18px 20px;margin:0 0 24px 0;">
                <p style="margin:0 0 10px 0;font-size:14px;font-weight:700;color:#0f172a;">Ce que vous pouvez faire maintenant :</p>
                <ul style="margin:0;padding-left:18px;color:#475569;font-size:14px;line-height:22px;">
                    <li>Compléter votre profil patient</li>
                    <li>Explorer les programmes disponibles</li>
                    <li>Commencer une première activité guidée</li>
                </ul>
            </div>

            <div style="text-align:center;margin:30px 0 12px;">
                <a href="{{ url('app_home') }}" class="btn" style="width:280px;background:linear-gradient(135deg,#0f766e 0%,#10b981 100%);">
                    Accéder à mon espace
                </a>
            </div>

            <p class="text" style="font-size:13px;color:#94a3b8;margin-bottom:0;text-align:center;">
                Vous recevez cet email car votre compte MindCare vient d'être créé.
            </p>
        </td>
    </tr>
</table>
{% endblock %}
