        <script>
            /**
             * Pure Vanilla JS Emoji Picker
             * Works without external libraries or complex build steps
             * No external APIs needed - all emojis are hardcoded
             */
            function setupEmojiPicker() {
                const triggers = document.querySelectorAll('[data-emoji-picker]');
                if (triggers.length === 0) return;

                // Create picker only once
                let picker = document.getElementById('global-emoji-picker');
                if (!picker) {
                    picker = document.createElement('div');
                    picker.id = 'global-emoji-picker';
                    picker.className = 'emoji-picker-dropdown';
                    
                    // Comprehensive emoji list organized by category
                    const emojis = [
                        // Smileys & People (😊😂😍🤔😢😎)
                        '😊', '😂', '😍', '🤔', '😢', '😎', '😍', '😏', '😄', '😁',
                        '🥰', '😘', '😂', '😅', '😆', '😉', '🤩', '😲', '😮', '😲',
                        // Hand gestures & hearts
                        '👍', '👌', '🙏', '👏', '💪', '🤝', '✌️', '👋', '🖐️', '✋',
                        // Hearts & love (❤️💜💙)
                        '❤️', '🧡', '💛', '💚', '💙', '💜', '🖤', '🤍', '💔', '💕',
                        // Symbols & elements (✨🔥⭐)
                        '✨', '🔥', '⭐', '⚡', '💥', '✅', '❌', '❓', '❗', '💡',
                        // Activities & celebrations (🎉🌈🎊)
                        '🎉', '🎊', '🎈', '🎁', '🌈', '🎭', '🎪', '🎯', '🏆', '🥇',
                        // Nature & animals
                        '🌟', '🌸', '🌻', '🌹', '🌺', '🐶', '😸', '🐰', '🦋', '🐝',
                        // Food & drinks
                        '👌', '😋', '🍕', '🍔', '🍟', '🍗', '🍰', '🍩', '☕', '🍷',
                        // Travel & places
                        '🚀', '✈️', '🚁', '🏠', '🏖️', '⛱️', '🏔️', '🗻', '🌊', '🌴',
                        // Weather & time
                        '☀️', '☁️', '⛅', '🌤️', '⛈️', '🌙', '⭐', '🌟', '💫', '✨'
                    ];
                    
                    emojis.forEach(emoji => {
                        const span = document.createElement('span');
                        span.textContent = emoji;
                        span.title = emoji;
                        span.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            
                            const targetId = picker.getAttribute('data-target-id');
                            const input = document.getElementById(targetId);
                            if (input) {
                                const start = input.selectionStart || 0;
                                const end = input.selectionEnd || 0;
                                const currentValue = input.value || '';
                                input.value = currentValue.substring(0, start) + emoji + currentValue.substring(end);
                                input.focus();
                                const newPos = start + emoji.length;
                                input.setSelectionRange(newPos, newPos);
                                input.dispatchEvent(new Event('input', { bubbles: true }));
                            }
                            picker.style.display = 'none';
                        });
                        picker.appendChild(span);
                    });
                    document.body.appendChild(picker);
                }

                // Attach listeners using a unique data attribute to prevent duplicates
                triggers.forEach(trigger => {
                    // Only attach if not already attached
                    if (!trigger.dataset.emojiPickerAttached) {
                        trigger.dataset.emojiPickerAttached = 'true';
                        
                        trigger.addEventListener('click', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            
                            const targetId = this.getAttribute('data-emoji-target');
                            if (!targetId) {
                                console.warn('Emoji trigger missing data-emoji-target');
                                return;
                            }
                            
                            const rect = this.getBoundingClientRect();
                            
                            // Toggle logic
                            if (picker.style.display === 'grid' && picker.getAttribute('data-target-id') === targetId) {
                                picker.style.display = 'none';
                                return;
                            }

                            picker.setAttribute('data-target-id', targetId);
                            picker.style.display = 'grid';
                            
                            // Smart positioning (fixed positioning, so don't add scroll offset)
                            let top = rect.bottom + 5;
                            let left = rect.left;

                            // Check viewport overflow
                            if (left + 260 > window.innerWidth) {
                                left = rect.right - 260;
                            }
                            
                            if (top + 300 > window.innerHeight) {
                                top = rect.top - 310;
                            }
                            
                            picker.style.top = top + 'px';
                            picker.style.left = left + 'px';
                        });
                    }
                });

                // Global click to close (attach only once)
                if (!window.emojiPickerCloseHandlerAttached) {
                    window.emojiPickerCloseHandlerAttached = true;
                    document.addEventListener('click', (e) => {
                        if (picker && !picker.contains(e.target) && !e.target.hasAttribute('data-emoji-picker')) {
                            picker.style.display = 'none';
                        }
                    });
                }
            }

            /**
             * AJAX Like Button Handler
             * Handles post and comment like functionality without page reload
             */
            function setupLikeButtons() {
                const likeButtons = document.querySelectorAll('.like-btn');
                
                likeButtons.forEach(btn => {
                    // Only attach if not already attached
                    if (!btn.dataset.likeAttached) {
                        btn.dataset.likeAttached = 'true';
                        
                        btn.addEventListener('click', async function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            
                            const url = this.getAttribute('data-like-url');
                            const counterElementId = this.getAttribute('data-likes-counter');
                            const counterElement = document.getElementById(counterElementId);
                            
                            if (!url || !counterElement) {
                                console.warn('Like button missing data attributes');
                                return;
                            }
                            
                            try {
                                const response = await fetch(url, {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                    }
                                });
                                
                                if (!response.ok) {
                                    console.error('Like request failed:', response.status);
                                    return;
                                }
                                
                                const data = await response.json();
                                
                                // Update the like count
                                counterElement.textContent = data.nbLikes;
                                
                                // Change button appearance based on liked status
                                if (data.liked) {
                                    this.style.opacity = '1';
                                    this.style.fontWeight = 'bold';
                                } else {
                                    this.style.opacity = '0.6';
                                    this.style.fontWeight = 'normal';
                                }
                            } catch (error) {
                                console.error('Error handling like:', error);
                            }
                        });
                    }
                });
            }

            
            // Initialize all interactive elements
            function initializeInteractiveElements() {
                setupEmojiPicker();
                setupLikeButtons();
            }

            // Re-run on every Turbo load and page changes
            document.addEventListener('turbo:load', initializeInteractiveElements);
            document.addEventListener('DOMContentLoaded', initializeInteractiveElements);
        </script>
    </head>
