{% extends 'base_psychologue.html.twig' %}

{% block title %}Verification d'identite{% endblock %}
{% block psychologue_title %}Verification d'identite{% endblock %}

{% block psychologue_body %}
<div class="card border-0 shadow-sm rounded-4 p-4">
    <h4 class="fw-bold mb-3">Verification d'identite</h4>
    <p class="mb-1"><strong>Patient :</strong> {{ appointment.patient ? appointment.patient.prenom ~ ' ' ~ appointment.patient.nom : '-' }}</p>
    <p class="mb-4"><strong>Rendez-vous :</strong> {{ appointment.plan ? appointment.plan.dayOfWeek ~ ' - ' ~ appointment.plan.period : '-' }}</p>

    {% if not has_photo %}
        <div class="alert alert-warning">
            Aucune photo de profil detectee. Vous pouvez confirmer sans verification faciale.
        </div>
        <form method="POST" action="{{ path('app_psychologue_appointments_confirm', {id: appointment.id}) }}" data-turbo="false">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <input type="hidden" name="face_verified" value="true">
            <button type="submit" class="btn btn-success">Confirmer sans verification</button>
            <a href="{{ path('app_psychologue_appointments_index') }}" class="btn btn-outline-secondary ms-2" data-turbo="false">Annuler</a>
        </form>
    {% else %}
        {# Hidden reference image — loaded by face-api.js #}
        <img id="reference-photo"
             src="{{ photo_url }}"
             crossorigin="anonymous"
             alt="Photo de reference"
             class="d-none">

        <div class="position-relative mx-auto border rounded-3 overflow-hidden" style="max-width:640px;">
            <video id="webcam" autoplay muted playsinline style="width:100%;display:block;"></video>
        </div>

        <div id="status-bar" class="alert alert-secondary mt-3 mb-3">
            Chargement des modeles IA...
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button id="capture-btn" class="btn btn-primary" disabled>
                <i class="fa-solid fa-camera me-1"></i> Capturer et verifier
            </button>
            <a href="{{ path('app_psychologue_appointments_index') }}" class="btn btn-outline-secondary" data-turbo="false">Annuler</a>
        </div>

        {# Hidden form submitted after successful verification #}
        <form id="confirm-form"
              method="POST"
              action="{{ path('app_psychologue_appointments_confirm', {id: appointment.id}) }}"
              class="d-none"
              data-turbo="false">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <input type="hidden" name="face_verified" value="true">
        </form>

        {# face-api.js from CDN #}
        <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>

        <script>
        (() => {
            const MODEL_URL   = '/models';
            const THRESHOLD   = 0.50;   // euclidean distance — lower = stricter

            const statusBar   = document.getElementById('status-bar');
            const webcam      = document.getElementById('webcam');
            const captureBtn  = document.getElementById('capture-btn');
            const refImg      = document.getElementById('reference-photo');
            const confirmForm = document.getElementById('confirm-form');

            let stream = null;

            const setStatus = (text, type = 'secondary') => {
                statusBar.className = `alert alert-${type} mt-3 mb-3`;
                statusBar.textContent = text;
            };

            // 1. Load models
            const loadModels = async () => {
                setStatus('Chargement des modeles IA (premiere fois peut prendre 10s)...', 'secondary');
                await Promise.all([
                    faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
                    faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL),
                ]);
            };

            // 2. Start webcam
            const startWebcam = async () => {
                stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                webcam.srcObject = stream;
                await new Promise(resolve => { webcam.onloadedmetadata = resolve; });
            };

            // 3. Get face descriptor from an image/video element
            const getDescriptor = async (input) => {
                const detection = await faceapi
                    .detectSingleFace(input, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks()
                    .withFaceDescriptor();
                return detection ? detection.descriptor : null;
            };

            // 4. Capture and compare
            const verify = async () => {
                captureBtn.disabled = true;
                setStatus('Analyse du visage en cours...', 'warning');

                try {
                    // Get descriptor from reference photo
                    const refDescriptor = await getDescriptor(refImg);
                    if (!refDescriptor) {
                        setStatus('Aucun visage detecte dans la photo de profil. Contactez l\'administrateur.', 'danger');
                        captureBtn.disabled = false;
                        return;
                    }

                    // Get descriptor from live webcam frame
                    const liveDescriptor = await getDescriptor(webcam);
                    if (!liveDescriptor) {
                        setStatus('Aucun visage detecte dans la webcam. Assurez-vous d\'etre bien eclaire et face a la camera.', 'danger');
                        captureBtn.disabled = false;
                        return;
                    }

                    // Compare
                    const distance = faceapi.euclideanDistance(refDescriptor, liveDescriptor);
                    const distanceRounded = Math.round(distance * 1000) / 1000;

                    if (distance <= THRESHOLD) {
                        setStatus(`Identite verifiee ✓ (distance: ${distanceRounded}). Confirmation en cours...`, 'success');
                        setTimeout(() => confirmForm.submit(), 1500);
                    } else {
                        setStatus(`Visage non reconnu (distance: ${distanceRounded}, seuil: ${THRESHOLD}). Reessayez.`, 'danger');
                        captureBtn.disabled = false;
                    }
                } catch (e) {
                    setStatus('Erreur: ' + e.message, 'danger');
                    captureBtn.disabled = false;
                }
            };

            // Init
            const init = async () => {
                try {
                    await loadModels();
                    await startWebcam();
                    captureBtn.disabled = false;
                    setStatus('Pret. Positionnez votre visage et cliquez sur "Capturer et verifier".', 'secondary');
                } catch (e) {
                    setStatus('Erreur d\'initialisation: ' + e.message, 'danger');
                }
            };

            captureBtn.addEventListener('click', verify);

            window.addEventListener('beforeunload', () => {
                if (stream) stream.getTracks().forEach(t => t.stop());
            });

            init();
        })();
        </script>
    {% endif %}
</div>
{% endblock %}
