{% extends 'base_psychologue.html.twig' %}

{% block title %}Nouvelle activité{% endblock %}
{% block psychologue_title %}Ajouter une activité{% endblock %}

{% block psychologue_body %}
<div class="card border-0 shadow-sm rounded-4 p-4" style="max-width:600px">
    <p class="text-muted mb-4">Ajoutez une activité au programme <strong>{{ programme.nom }}</strong>.</p>

    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

    <div class="mb-3">
        {{ form_label(form.titre, 'Titre', { label_attr: { class: 'form-label fw-semibold' } }) }}
        {{ form_widget(form.titre, { attr: { class: 'form-control rounded-3' } }) }}
        {{ form_errors(form.titre) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.description, 'Description', { label_attr: { class: 'form-label fw-semibold' } }) }}
        {{ form_widget(form.description, { attr: { class: 'form-control rounded-3', rows: 3 } }) }}
        {{ form_errors(form.description) }}
    </div>
    <div class="row g-3 mb-3">
        <div class="col">
            {{ form_label(form.jour, 'Jour', { label_attr: { class: 'form-label fw-semibold' } }) }}
            {{ form_widget(form.jour, { attr: { class: 'form-control rounded-3' } }) }}
            {{ form_errors(form.jour) }}
        </div>
        <div class="col">
            {{ form_label(form.heureDebut, 'Heure début', { label_attr: { class: 'form-label fw-semibold' } }) }}
            {{ form_widget(form.heureDebut, { attr: { class: 'form-control rounded-3' } }) }}
            {{ form_errors(form.heureDebut) }}
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col">
            {{ form_label(form.dureeMinutes, 'Durée (min)', { label_attr: { class: 'form-label fw-semibold' } }) }}
            {{ form_widget(form.dureeMinutes, { attr: { class: 'form-control rounded-3' } }) }}
            {{ form_errors(form.dureeMinutes) }}
        </div>
        <div class="col">
            {{ form_label(form.typeActivite, 'Type', { label_attr: { class: 'form-label fw-semibold' } }) }}
            {{ form_widget(form.typeActivite, { attr: { class: 'form-select rounded-3' } }) }}
            {{ form_errors(form.typeActivite) }}
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary rounded-pill px-4">Ajouter</button>
        <a href="{{ path('app_psychologue_programmes_show', {id: programme.id}) }}" class="btn btn-light rounded-pill px-4">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
