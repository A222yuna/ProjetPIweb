{% extends 'base_psychologue.html.twig' %}

{% block title %}Plans - Psychologue{% endblock %}

{% block psychologue_body %}
    <h1 class="h4 mb-3">Mes plans (planning)</h1>
    <div class="d-flex gap-2 mb-3">
        <a class="btn btn-sm btn-primary" href="{{ path('app_psychologue_plans_new') }}">Nouveau plan</a>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_psychologue_disponibilites_index') }}">Disponibilités</a>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_psychologue_appointments_index') }}">Appointments</a>
    </div>

    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Jour</th>
                        <th>Période</th>
                        <th>Max RDV</th>
                        <th>Créé le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for p in plans %}
                    <tr>
                        <td>{{ p.dayOfWeek }}</td>
                        <td>{{ p.period }}</td>
                        <td>{{ p.maxAppointments }}</td>
                        <td>{{ p.createdAt ? p.createdAt|date('d/m/Y H:i') : '-' }}</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_psychologue_plans_edit', { id: p.id }) }}">Edit</a>
                            <form method="post" action="{{ path('app_psychologue_plans_delete', { id: p.id }) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_plan_' ~ p.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun plan.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

