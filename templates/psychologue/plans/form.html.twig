{% extends 'base_psychologue.html.twig' %}

{% block title %}{{ is_edit ? 'Edit plan' : 'New plan' }}{% endblock %}

{% block psychologue_body %}
    <h1 class="h4 mb-3">{{ is_edit ? 'Modifier un plan' : 'Nouveau plan' }}</h1>

    <div class="card p-3">
        {{ form_start(form) }}

        <div class="mb-3">
            <label class="form-label">Jour</label>
            {{ form_widget(form.dayOfWeek, { attr: { class: 'form-select ' ~ (form.dayOfWeek.vars.errors|length ? 'is-invalid' : '') } }) }}
            {% for e in form.dayOfWeek.vars.errors %}<div class="invalid-feedback d-block">{{ e.message }}</div>{% endfor %}
        </div>

        <div class="mb-3">
            <label class="form-label">Période</label>
            {{ form_widget(form.period, { attr: { class: 'form-select ' ~ (form.period.vars.errors|length ? 'is-invalid' : '') } }) }}
            {% for e in form.period.vars.errors %}<div class="invalid-feedback d-block">{{ e.message }}</div>{% endfor %}
        </div>

        <div class="mb-3">
            <label class="form-label">Max rendez-vous</label>
            {{ form_widget(form.maxAppointments, { attr: { class: 'form-control ' ~ (form.maxAppointments.vars.errors|length ? 'is-invalid' : '') } }) }}
            {% for e in form.maxAppointments.vars.errors %}<div class="invalid-feedback d-block">{{ e.message }}</div>{% endfor %}
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">{{ is_edit ? 'Mettre à jour' : 'Créer' }}</button>
            <a class="btn btn-outline-secondary" href="{{ path('app_psychologue_plans_index') }}">Retour</a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}

