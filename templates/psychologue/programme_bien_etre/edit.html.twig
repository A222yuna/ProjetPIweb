{% extends 'base.html.twig' %}

{% block title %}Modifier « {{ programme.nom }} » — Psychologue{% endblock %}

{% block stylesheets %}
<style>
    .form-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 2.5rem 3rem;
        box-shadow: 0 8px 32px rgba(28, 40, 36, 0.08);
        max-width: 920px;
        margin-bottom: 3rem;
    }
    .form-card-header {
        margin-bottom: 1.75rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
    }
    .form-card-header h2 {
        font-family: var(--font-serif);
        font-size: 1.3rem;
        margin: 0 0 .35rem;
        color: var(--text);
    }
    .form-card-header p {
        margin: 0;
        color: var(--muted);
        font-size: .9rem;
    }
    .form-section-title {
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--accent);
        margin: 1.5rem 0 .75rem;
        padding-bottom: .4rem;
        border-bottom: 2px solid var(--accent-soft);
    }
    .current-img {
        margin-top: .5rem;
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .65rem .75rem;
        background: #faf9f7;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        font-size: .85rem;
        color: var(--muted);
    }
    .current-img img {
        width: 60px;
        height: 45px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid var(--border);
    }
</style>
{% endblock %}

{% block body %}
<a href="{{ path('app_psychologue_programme_show', {id: programme.id}) }}" class="back-link">← Retour au programme</a>

<div class="page-eyebrow">Espace Psychologue</div>
<h1>Modifier le programme</h1>

<div class="form-card">
    {{ form_start(form, {'attr': {'class': 'stack-form', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

    <div class="form-card-header">
        <h2>✏️ {{ programme.nom }}</h2>
        <p>Modifiez les informations de votre programme ci-dessous.</p>
    </div>

    {{ form_row(form.nom) }}
    {{ form_row(form.objectif) }}

    <div class="form-section-title">Configuration</div>

    <div class="grid-2">
        <div>{{ form_row(form.duree) }}</div>
        <div>{{ form_row(form.niveauDifficulte) }}</div>
    </div>

    <div class="grid-2">
        <div>{{ form_row(form.statut) }}</div>
        <div>
            {{ form_row(form.imageFile) }}
            {% if programme.image %}
                <div class="current-img">
                    <img src="{{ programme.image starts with 'http' ? programme.image : asset('uploads/' ~ programme.image) }}" alt="Image actuelle">
                    <span>Image actuelle — Uploadez un fichier pour la remplacer</span>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="stack-form-actions">
        <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
        <a href="{{ path('app_psychologue_programme_show', {id: programme.id}) }}" class="btn btn-outline">Annuler</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
