{% extends 'base_psychologue.html.twig' %}

{% block title %}Modifier programme{% endblock %}
{% block psychologue_title %}Modifier le programme{% endblock %}

{% block psychologue_body %}
<div class="card border-0 shadow-sm rounded-4 p-4" style="max-width:700px">
    <p class="text-muted mb-4">Modifiez les informations du programme <strong>{{ programme.nom }}</strong>.</p>

    {{ form_start(form, { attr: { novalidate: 'novalidate', enctype: 'multipart/form-data' } }) }}

    <div class="mb-3">
        {{ form_label(form.nom, 'Nom du programme', { label_attr: { class: 'form-label fw-semibold' } }) }}
        {{ form_widget(form.nom, { attr: { class: 'form-control rounded-3' } }) }}
        {{ form_errors(form.nom) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.objectif, 'Objectif', { label_attr: { class: 'form-label fw-semibold' } }) }}
        {{ form_widget(form.objectif, { attr: { class: 'form-control rounded-3', rows: 3 } }) }}
        {{ form_errors(form.objectif) }}
    </div>

    <div class="row g-3 mb-3">
        <div class="col">
            {{ form_label(form.duree, 'Durée (jours)', { label_attr: { class: 'form-label fw-semibold' } }) }}
            {{ form_widget(form.duree, { attr: { class: 'form-control rounded-3' } }) }}
            {{ form_errors(form.duree) }}
        </div>
        <div class="col">
            {{ form_label(form.niveauDifficulte, 'Niveau', { label_attr: { class: 'form-label fw-semibold' } }) }}
            {{ form_widget(form.niveauDifficulte, { attr: { class: 'form-select rounded-3' } }) }}
            {{ form_errors(form.niveauDifficulte) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_label(form.statut, 'Statut', { label_attr: { class: 'form-label fw-semibold' } }) }}
        {{ form_widget(form.statut, { attr: { class: 'form-select rounded-3' } }) }}
        {{ form_errors(form.statut) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.imageFile, 'Image (optionnel)', { label_attr: { class: 'form-label fw-semibold' } }) }}
        {{ form_widget(form.imageFile, { attr: { class: 'form-control rounded-3' } }) }}
        {{ form_errors(form.imageFile) }}
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary rounded-pill px-4">Enregistrer</button>
        <a href="{{ path('app_psychologue_programmes_index') }}" class="btn btn-light rounded-pill px-4">Annuler</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
