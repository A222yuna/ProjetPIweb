{% extends 'base.html.twig' %}

{% block title %}Nouveau programme — Psychologue{% endblock %}

{% block stylesheets %}
<style>
    .form-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 2.5rem 3rem;
        box-shadow: 0 8px 32px rgba(28, 40, 36, 0.08);
        max-width: 920px;
        margin-bottom: 3rem;
    }
    .form-card-header {
        margin-bottom: 1.75rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
    }
    .form-card-header h2 {
        font-family: var(--font-serif);
        font-size: 1.3rem;
        margin: 0 0 .35rem;
        color: var(--text);
    }
    .form-card-header p {
        margin: 0;
        color: var(--muted);
        font-size: .9rem;
    }
    .form-section-title {
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--accent);
        margin: 1.5rem 0 .75rem;
        padding-bottom: .4rem;
        border-bottom: 2px solid var(--accent-soft);
    }
    .img-preview {
        margin-top: .5rem;
        padding: .75rem;
        background: #faf9f7;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        text-align: center;
        font-size: .85rem;
        color: var(--muted);
    }
</style>
{% endblock %}

{% block body %}
<a href="{{ path('app_psychologue_programme_index') }}" class="back-link">← Retour aux programmes</a>

<div class="page-eyebrow">Espace Psychologue</div>
<h1>Créer un programme</h1>
<p class="page-lead">Définissez un nouveau programme bien-être pour accompagner vos patients.</p>

<div class="form-card">
    {{ form_start(form, {'attr': {'class': 'stack-form', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

    <div class="form-card-header">
        <h2>🧘 Informations du programme</h2>
        <p>Renseignez le nom, l'objectif et la durée de votre programme.</p>
    </div>

    {{ form_row(form.nom) }}
    {{ form_row(form.objectif) }}

    <div class="form-section-title">Configuration</div>

    <div class="grid-2">
        <div>{{ form_row(form.duree) }}</div>
        <div>{{ form_row(form.niveauDifficulte) }}</div>
    </div>

    <div class="grid-2">
        <div>{{ form_row(form.statut) }}</div>
        <div>
            {{ form_row(form.imageFile) }}
            <div class="img-preview">📸 Formats acceptés : JPEG, PNG, WebP — Max 2 Mo</div>
        </div>
    </div>

    <div class="stack-form-actions">
        <button type="submit" class="btn btn-primary">✨ Créer le programme</button>
        <a href="{{ path('app_psychologue_programme_index') }}" class="btn btn-outline">Annuler</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
