{% extends 'base_psychologue.html.twig' %}

{% block title %}{{ programme.nom }}{% endblock %}
{% block psychologue_title %}{{ programme.nom }}{% endblock %}

{% block psychologue_body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="{{ path('app_psychologue_programmes_index') }}" class="btn btn-light rounded-pill">
        <i class="fa-solid fa-arrow-left me-2"></i>Retour
    </a>
    <div class="d-flex gap-2">
        <a href="{{ path('app_psychologue_activite_new', {id: programme.id}) }}" class="btn btn-success rounded-pill">
            <i class="fa-solid fa-plus me-1"></i>Ajouter une activité
        </a>
        <a href="{{ path('app_psychologue_programmes_edit', {id: programme.id}) }}" class="btn btn-outline-secondary rounded-pill">
            <i class="fa-solid fa-pen me-1"></i>Modifier
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-8">
            <h4 class="fw-bold">{{ programme.nom }}</h4>
            <p class="text-muted">{{ programme.objectif }}</p>
            <div class="d-flex gap-3 flex-wrap">
                <span><i class="fa-solid fa-calendar-days me-1 text-primary"></i>{{ programme.duree }} jours</span>
                <span><i class="fa-solid fa-signal me-1 text-info"></i>{{ programme.niveauDifficulte ?? 'Non défini' }}</span>
                <span class="badge rounded-pill {% if programme.statut == 'actif' %}bg-success{% elseif programme.statut == 'brouillon' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                    {{ programme.statut ?? 'brouillon' }}
                </span>
            </div>
        </div>
        {% if programme.image %}
        <div class="col-md-4">
            <img src="{{ asset('uploads/programmes/' ~ programme.image) }}" class="img-fluid rounded-3" alt="{{ programme.nom }}">
        </div>
        {% endif %}
    </div>
</div>

<h5 class="fw-bold mb-3">Activités ({{ programme.activites|length }})</h5>

{% if programme.activites is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-muted">
        Aucune activité. <a href="{{ path('app_psychologue_activite_new', {id: programme.id}) }}">Ajouter la première</a>
    </div>
{% else %}
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle border-0">
                <thead class="bg-light">
                    <tr>
                        <th>Jour</th>
                        <th>Heure</th>
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Durée</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for a in programme.activites %}
                    <tr>
                        <td>Jour {{ a.jour }}</td>
                        <td>{{ a.heureDebut ? a.heureDebut|date('H:i') : '-' }}</td>
                        <td><strong>{{ a.titre }}</strong><br><small class="text-muted">{{ a.description|length > 50 ? a.description|slice(0,50) ~ '...' : a.description }}</small></td>
                        <td><span class="badge bg-light text-dark border">{{ a.typeActivite ?? '-' }}</span></td>
                        <td>{{ a.dureeMinutes ? a.dureeMinutes ~ ' min' : '-' }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_psychologue_activite_edit', {programmeId: programme.id, id: a.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill">Modifier</a>
                            <form method="post" action="{{ path('app_psychologue_activite_delete', {programmeId: programme.id, id: a.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{% if programme.avis is defined and programme.avis|length > 0 %}
<h5 class="fw-bold mt-4 mb-3">Avis patients ({{ programme.avis|length }})</h5>
<div class="card border-0 shadow-sm rounded-4 p-4">
    {% for avis in programme.avis %}
    <div class="border-bottom pb-3 mb-3">
        <div class="d-flex justify-content-between">
            <strong>{{ avis.patient ? avis.patient.prenom ~ ' ' ~ avis.patient.nom : 'Anonyme' }}</strong>
            <span>{% for i in 1..5 %}{{ i <= avis.note ? '⭐' : '☆' }}{% endfor %}</span>
        </div>
        <p class="text-muted small mb-0">{{ avis.commentaire }}</p>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
