{% extends 'base.html.twig' %}

{% block title %}{{ programme.nom }} — Psychologue{% endblock %}

{% block body_attr %}class="layout-wide"{% endblock %}

{% block stylesheets %}
<style>
    /* Whole page width adjustment */
    body.layout-wide .wrap { max-width: 1550px !important; }

    .prog-header-section {
        background: linear-gradient(145deg, var(--surface) 0%, var(--accent-soft) 100%);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: 2.5rem;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0,0,0,0.04);
        display: grid;
        grid-template-columns: 1.2fr 1fr;
    }
    @media(max-width: 992px) { .prog-header-section { grid-template-columns: 1fr; } }

    .prog-header-content { padding: 3rem; }
    .prog-header-visual {
        background-size: cover;
        background-position: center;
        min-height: 350px;
        position: relative;
    }
    .prog-header-visual::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to right, rgba(255,255,255,0.1), transparent);
    }
    .prog-header-placeholder {
        height: 100%; width: 100%;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, var(--accent-soft) 0%, #e8e6e1 100%);
        font-size: 5rem;
    }

    .meta-badges { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.5rem 0; }
    .meta-badge-large {
        background: var(--surface);
        border: 1px solid var(--border);
        padding: .6rem 1rem;
        border-radius: 12px;
        display: flex; align-items: center; gap: .5rem;
        font-weight: 600; font-size: .92rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .meta-badge-large i { font-size: 1.1rem; color: var(--accent); }

    /* Activities Grid */
    .activities-day-scroller {
        display: flex; gap: 1.5rem;
        overflow-x: auto; padding-bottom: 1.5rem;
        margin-bottom: 1rem;
        scrollbar-width: thin;
        scrollbar-color: var(--accent) transparent;
    }
    .activities-day-scroller::-webkit-scrollbar { height: 6px; }
    .activities-day-scroller::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }

    .day-column {
        min-width: 340px; flex-shrink: 0;
        display: flex; flex-direction: column; gap: 1rem;
    }
    .day-marker {
        position: sticky; top: 0;
        background: var(--bg);
        padding: .5rem 0; z-index: 10;
        font-family: var(--font-serif);
        font-size: 1.25rem; font-weight: 700;
        border-bottom: 2px solid var(--accent);
        display: flex; justify-content: space-between; align-items: center;
    }
    .activity-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.25rem;
        box-shadow: var(--shadow);
        transition: transform .2s ease, border-color .2s ease;
        position: relative;
    }
    .activity-card:hover {
        transform: translateY(-3px);
        border-color: var(--accent);
    }
    .activity-card-time {
        font-size: .8rem; font-weight: 700; color: var(--accent);
        text-transform: uppercase; letter-spacing: .05em;
        margin-bottom: .4rem;
    }
    .activity-card h4 {
        margin: 0 0 .5rem; font-size: 1.05rem; line-height: 1.35;
        font-family: var(--font-serif);
    }
    .activity-card-desc {
        font-size: .88rem; color: var(--muted);
        line-height: 1.5; margin: 0;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .activity-card-footer {
        margin-top: 1rem; padding-top: .75rem;
        border-top: 1px solid var(--border);
        display: flex; justify-content: space-between; align-items: center;
    }
    .activity-type-pill {
        font-size: .7rem; font-weight: 700; text-transform: uppercase;
        padding: .25rem .5rem; border-radius: 4px; background: var(--accent-soft);
        color: var(--accent);
    }

    /* Reviews Section */
    .reviews-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 1.25rem;
        margin-top: 1.5rem;
    }
    .review-bubble {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.75rem;
        box-shadow: var(--shadow);
        display: flex; flex-direction: column; gap: 1rem;
    }
    .review-bubble-head { display: flex; justify-content: space-between; align-items: flex-start; }
    .review-user { display: flex; align-items: center; gap: .85rem; }
    .review-avatar {
        width: 44px; height: 44px; border-radius: 50%;
        background: var(--accent-soft); color: var(--accent);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1.1rem;
    }
    .review-info strong { display: block; font-size: .95rem; }
    .review-info span { font-size: .8rem; color: var(--muted); }

    .action-group {
        display: flex; gap: .75rem; align-items: center;
    }

    .stat-pills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
    .stat-pill {
        text-align: center; background: rgba(255,255,255,0.5);
        border-radius: 12px; padding: .75rem; border: 1px solid rgba(0,0,0,0.03);
    }
    .stat-pill-num { display: block; font-size: 1.5rem; font-weight: 700; color: var(--accent); }
    .stat-pill-label { font-size: .75rem; font-weight: 600; text-transform: uppercase; color: var(--muted); }

</style>
{% endblock %}

{% block body %}
<a href="{{ path('app_psychologue_programme_index') }}" class="back-link">← Retour aux programmes</a>

<div class="prog-header-section">
    <div class="prog-header-content">
        <div class="page-eyebrow">Psychologue Dashboard</div>
        <h1 style="margin-bottom:1rem; font-size: clamp(2rem, 4vw, 3rem);">{{ programme.nom }}</h1>

        <div class="meta-badges">
            <div class="meta-badge-large">
                <i>⏱</i> {{ programme.duree }} Jours
            </div>
            <div class="meta-badge-large">
                <i>🎯</i> {{ programme.niveauDifficulte|default('Standard')|capitalize }}
            </div>
            <div class="meta-badge-large">
                {% if programme.statut == 'actif' %}
                    <span style="color:#2a6f5b">● Actif</span>
                {% else %}
                    <span style="color:var(--muted)">● {{ programme.statut|capitalize }}</span>
                {% endif %}
            </div>
        </div>

        {% if programme.objectif %}
            <p class="page-lead" style="max-width: none">{{ programme.objectif }}</p>
        {% endif %}

        <div class="stat-pills">
            <div class="stat-pill">
                <span class="stat-pill-num">{{ programme.activites|length }}</span>
                <span class="stat-pill-label">Activités</span>
            </div>
            <div class="stat-pill">
                <span class="stat-pill-num">{{ programme.avis|length }}</span>
                <span class="stat-pill-label">Avis Patients</span>
            </div>
            <div class="stat-pill">
                <span class="stat-pill-num">
                    {% set total = 0 %}{% for a in programme.avis %}{% set total = total + a.note %}{% endfor %}
                    {{ programme.avis|length > 0 ? (total / programme.avis|length)|round(1) : '—' }}
                </span>
                <span class="stat-pill-label">Note Moyenne</span>
            </div>
        </div>

        <div class="action-group" style="margin-top: 2rem;">
            <a href="{{ path('app_psychologue_programme_edit', {id: programme.id}) }}" class="btn btn-primary">✏️ Modifier le programme</a>
            <form method="post" action="{{ path('app_psychologue_programme_delete', {id: programme.id}) }}" onsubmit="return confirm('Attention: Toutes les activités seront aussi supprimées. Continuer ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ programme.id) }}">
                <button class="btn btn-outline" style="color:#a42020;border-color:#e2b0b0">🗑 Supprimer</button>
            </form>
        </div>
    </div>
    {% if programme.image %}
        <div class="prog-header-visual" style="background-image: url('{{ programme.image starts with 'http' ? programme.image : asset('uploads/' ~ programme.image) }}')"></div>
    {% else %}
        <div class="prog-header-visual">
            <div class="prog-header-placeholder">🧘</div>
        </div>
    {% endif %}
</div>

<div class="section-head">
    <h2 style="margin:0">📅 Contenu du programme</h2>
    <div class="action-group">
        <a href="{{ path('app_psychologue_activite_new', {programmeId: programme.id}) }}" class="btn btn-primary btn-sm">＋ Ajouter une activité</a>
    </div>
</div>

{% if programme.activites is empty %}
    <div class="empty-state">
        <div style="font-size:3rem;margin-bottom:1rem">📋</div>
        <h3>Aucune activité planifiée</h3>
        <p class="muted">Commencez par ajouter votre première activité pour structurer ce programme.</p>
        <a href="{{ path('app_psychologue_activite_new', {programmeId: programme.id}) }}" class="btn btn-primary" style="margin-top:1rem">Ajouter une activité</a>
    </div>
{% else %}
    {# Organize by day for the horizontal layout #}
    {% set days_data = {} %}
    {% for a in programme.activites %}
        {% set d_key = 'day_' ~ a.jour %}
        {% if days_data[d_key] is not defined %}
            {% set days_data = days_data|merge({(d_key): []}) %}
        {% endif %}
        {% set days_data = days_data|merge({(d_key): days_data[d_key]|merge([a])}) %}
    {% endfor %}

    <div class="activities-day-scroller">
        {% for day_num in 1..(programme.duree) %}
            {% set current_day_key = 'day_' ~ day_num %}
            <div class="day-column">
                <div class="day-marker">
                    <span>Jour {{ day_num }}</span>
                    {% if days_data[current_day_key] is defined %}
                        <small style="font-size:.8rem; font-family:var(--font-sans); color:var(--muted)">{{ days_data[current_day_key]|length }} act.</small>
                    {% endif %}
                </div>
                
                {% if days_data[current_day_key] is defined %}
                    {% for a in days_data[current_day_key]|sort((a, b) => a.heureDebut|date('H:i') <=> b.heureDebut|date('H:i')) %}
                        <div class="activity-card">
                            <div class="activity-card-time">
                                {{ a.heureDebut ? a.heureDebut|date('H:i') : 'Horaire libre' }}
                                {% if a.dureeMinutes %} · {{ a.dureeMinutes }} min{% endif %}
                            </div>
                            <h4>{{ a.titre }}</h4>
                            <p class="activity-card-desc">{{ a.description|default('Aucune description') }}</p>
                            
                            <div class="activity-card-footer">
                                <span class="activity-type-pill">{{ a.typeActivite|default('Autre')|capitalize }}</span>
                                <div style="display:flex; gap:.35rem">
                                    <a href="{{ path('app_psychologue_activite_edit', {programmeId: programme.id, id: a.id}) }}" style="color:var(--muted); font-size:1rem" title="Éditer">✏️</a>
                                    <form method="post" action="{{ path('app_psychologue_activite_delete', {programmeId: programme.id, id: a.id}) }}" onsubmit="return confirm('Supprimer ?')" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a.id) }}">
                                        <button style="background:none; border:none; padding:0; cursor:pointer; font-size:1rem; color:#a42020" title="Supprimer">🗑</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div style="border:1px dashed var(--border); border-radius:12px; padding:2rem; text-align:center; color:var(--muted); font-size:.85rem">
                        Repos ou contenu libre
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}

<div class="section-head" style="margin-top: 3.5rem;">
    <h2 style="margin:0">⭐ Retours d'expérience ({{ programme.avis|length }})</h2>
</div>

{% if programme.avis is empty %}
    <div class="empty-state" style="margin-bottom:3rem">
        <p class="muted">Aucun patient n'a encore laissé d'avis sur ce programme.</p>
    </div>
{% else %}
    <div class="reviews-grid">
        {% for a in programme.avis %}
            <div class="review-bubble">
                <div class="review-bubble-head">
                    <div class="review-user">
                        <div class="review-avatar">
                            {{ (a.patient ? a.patient.prenom|slice(0,1) : 'P')|upper }}
                        </div>
                        <div class="review-info">
                            <strong>{{ a.patient ? a.patient.prenom ~ ' ' ~ a.patient.nom : 'Patient anonyme' }}</strong>
                            <span>{{ a.dateAvis ? a.dateAvis|date('d F Y') : 'Date inconnue' }}</span>
                        </div>
                    </div>
                    <div class="stars">
                        {% for i in 1..5 %}{{ i <= a.note ? '★' : '☆' }}{% endfor %}
                    </div>
                </div>
                {% if a.commentaire %}
                    <p style="margin:0; line-height:1.6; color:var(--text)">{{ a.commentaire }}</p>
                {% else %}
                    <p style="margin:0; font-style:italic; color:var(--muted)">L'utilisateur n'a pas laissé de commentaire.</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}

{% endblock %}
