{% extends 'base_psychologue.html.twig' %}

{% block title %}Mes programmes{% endblock %}
{% block psychologue_title %}Mes programmes bien-être{% endblock %}

{% block psychologue_body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">Gérez vos programmes de bien-être et les activités associées.</p>
    </div>
    <a href="{{ path('app_psychologue_programmes_new') }}" class="btn btn-primary rounded-pill px-4">
        <i class="fa-solid fa-plus me-2"></i>Nouveau programme
    </a>
</div>

{% if programmes is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="mb-3" style="font-size:3rem">🧘</div>
        <h5 class="fw-bold">Aucun programme créé</h5>
        <p class="text-muted">Créez votre premier programme bien-être pour vos patients.</p>
        <a href="{{ path('app_psychologue_programmes_new') }}" class="btn btn-primary rounded-pill px-4 mt-2">
            Créer mon premier programme
        </a>
    </div>
{% else %}
    <div class="row g-4">
        {% for p in programmes %}
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                {% if p.image %}
                    <img src="{{ asset('uploads/programmes/' ~ p.image) }}" class="card-img-top rounded-top-4" style="height:160px;object-fit:cover" alt="{{ p.nom }}">
                {% else %}
                    <div class="rounded-top-4 d-flex align-items-center justify-content-center bg-light" style="height:100px;font-size:2.5rem">🧘</div>
                {% endif %}
                <div class="card-body">
                    <h5 class="fw-bold mb-1">{{ p.nom }}</h5>
                    <p class="text-muted small mb-2">{{ p.duree }} jours · {{ p.niveauDifficulte ?? 'Moyen' }}</p>
                    <p class="small mb-3">{{ p.objectif|length > 80 ? p.objectif|slice(0,80) ~ '...' : p.objectif }}</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge rounded-pill {% if p.statut == 'actif' %}bg-success{% elseif p.statut == 'brouillon' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                            {{ p.statut ?? 'brouillon' }}
                        </span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3 px-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="{{ path('app_psychologue_programmes_show', {id: p.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill">Voir</a>
                        <a href="{{ path('app_psychologue_activite_new', {id: p.id}) }}" class="btn btn-sm btn-outline-success rounded-pill">+ Activité</a>
                        <a href="{{ path('app_psychologue_programmes_edit', {id: p.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill">Modifier</a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
