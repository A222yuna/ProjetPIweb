{% extends 'base_psychologue.html.twig' %}

{% block title %}Mes rendez-vous{% endblock %}

{% block psychologue_body %}
    <h1 class="h4 mb-3">Mes rendez-vous</h1>
    <div class="d-flex gap-2 mb-3">
        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_psychologue_plans_index') }}">Plans</a>
        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_psychologue_disponibilites_index') }}">Disponibilités</a>
    </div>

    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                {% for a in appointments %}
                    <tr>
                        <td>#{{ a.id }}</td>
                        <td>{{ a.patient ? a.patient.prenom ~ ' ' ~ a.patient.nom : '-' }}</td>
                        <td>{{ a.createdAt ? a.createdAt|date('d/m/Y H:i') : '-' }}</td>
                        <td>{{ a.status }}</td>
                        <td>
                            {% if a.status == 'SCHEDULED' %}
                                <form method="post" action="{{ path('app_psychologue_appointments_complete', { id: a.id }) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('complete_appointment_' ~ a.id) }}">
                                    <button class="btn btn-sm btn-outline-success" type="submit">Marquer COMPLETED</button>
                                </form>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun rendez-vous.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

