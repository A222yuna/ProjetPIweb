{% extends 'base_psychologue.html.twig' %}

{% block psychologue_title %}Nouveau Programme Bien-être{% endblock %}

{% block psychologue_body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="d-flex align-items-center mb-4">
                    <a href="{{ path('app_psychologue_programmes_index') }}" class="btn btn-sm btn-white border rounded-circle me-3">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                    <h4 class="fw-bold mb-0">Créer un nouveau programme</h4>
                </div>

                {{ form_start(form) }}
                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            {{ form_row(form.nom, {
                                'label': 'Nom du programme',
                                'attr': {'placeholder': 'Ex: Méditation de pleine conscience', 'class': 'form-control rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.duree, {
                                'label': 'Durée (jours)',
                                'attr': {'class': 'form-control rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.niveauDifficulte, {
                                'label': 'Niveau de difficulté',
                                'attr': {'class': 'form-select rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.objectif, {
                                'label': 'Objectif du programme',
                                'attr': {'placeholder': 'Quel est le but de ce programme ?', 'class': 'form-control rounded-4 p-3', 'rows': 5}
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.statut, {
                                'label': 'Statut',
                                'attr': {'class': 'form-select rounded-pill p-3'}
                            }) }}
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary rounded-pill p-3 fw-bold shadow-sm">
                            <i class="fa-solid fa-save me-2"></i> Enregistrer le programme
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
