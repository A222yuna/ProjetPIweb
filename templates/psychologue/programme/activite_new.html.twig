{% extends 'base_psychologue.html.twig' %}

{% block psychologue_title %}Ajouter une activité au programme: {{ programme.nom }}{% endblock %}

{% block psychologue_body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="d-flex align-items-center mb-4">
                    <a href="{{ path('app_psychologue_programmes_show', {id: programme.id}) }}" class="btn btn-sm btn-white border rounded-circle me-3">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                    <h4 class="fw-bold mb-0">Ajouter une activité au programme</h4>
                </div>

                {{ form_start(form) }}
                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            {{ form_row(form.titre, {
                                'label': 'Titre de l\'activité',
                                'attr': {'placeholder': 'Ex: Méditation matinale', 'class': 'form-control rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.jour, {
                                'label': 'Jour du programme',
                                'attr': {'class': 'form-control rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.heureDebut, {
                                'label': 'Heure de début',
                                'attr': {'class': 'form-control rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.dureeMinutes, {
                                'label': 'Durée (minutes)',
                                'attr': {'class': 'form-control rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-md-12">
                            {{ form_row(form.typeActivite, {
                                'label': 'Type d\'activité',
                                'attr': {'placeholder': 'Ex: Méditation, Exercice', 'class': 'form-control rounded-pill p-3'}
                            }) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.description, {
                                'label': 'Description de l\'activité',
                                'attr': {'placeholder': 'Décrivez ce que le patient doit faire.', 'class': 'form-control rounded-4 p-3', 'rows': 5}
                            }) }}
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary rounded-pill p-3 fw-bold shadow-sm">
                            <i class="fa-solid fa-plus-circle me-2"></i> Ajouter l'activité
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
