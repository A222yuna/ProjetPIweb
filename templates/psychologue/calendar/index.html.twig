{% extends 'base_psychologue.html.twig' %}

{% block title %}Mon Calendrier{% endblock %}

{% block psychologue_title %}Mon Calendrier de Travail{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #calendar {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            min-height: 700px;
        }
        .fc-header-toolbar {
            margin-bottom: 2em !important;
        }
        .fc-button-primary {
            background-color: #34495e !important;
            border-color: #34495e !important;
        }
        .fc-button-active {
            background-color: #2c3e50 !important;
            border-color: #2c3e50 !important;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }
        .legend-color {
            width: 15px;
            height: 15px;
            border-radius: 3px;
        }
    </style>
{% endblock %}

{% block psychologue_body %}
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Planning des consultations</h5>
            <div class="d-flex gap-3 flex-wrap">
                <div class="legend-item"><div class="legend-color" style="background: #ffc107;"></div><span>Prévu</span></div>
                <div class="legend-item"><div class="legend-color" style="background: #0dcaf0;"></div><span>Confirmé</span></div>
                <div class="legend-item"><div class="legend-color" style="background: #0d6efd;"></div><span>Payé</span></div>
                <div class="legend-item"><div class="legend-color" style="background: #198754;"></div><span>Terminé</span></div>
                <div class="legend-item"><div class="legend-color" style="background: #dc3545;"></div><span>Annulé</span></div>
            </div>
        </div>

        <div id="calendar" 
             data-calendar="1" 
             data-calendar-events="{{ path('app_psychologue_calendar_events') }}"
             data-view-url="{{ path('app_psychologue_appointments_index') }}">
        </div>
    </div>

    <!-- Modal Détails -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="eventTitle">Détails du rendez-vous</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                            <i class="fa-solid fa-user fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold" id="patientNameDisplay">-</h6>
                            <p class="text-muted small mb-0" id="patientEmailDisplay">-</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1">Date & Heure</small>
                                <span class="fw-semibold" id="eventStartDisplay">-</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1">Statut</small>
                                <span class="badge rounded-pill" id="eventStatusDisplay">-</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1">Planning</small>
                                <span class="fw-semibold" id="eventPlanDisplay">-</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
                    <a id="viewAppointmentBtn" href="#" class="btn btn-primary rounded-pill px-4">Gérer</a>
                </div>
            </div>
        </div>
    </div>


{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
