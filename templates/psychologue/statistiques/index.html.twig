{% extends 'base_psychologue.html.twig' %}

{% block title %}Statistiques & Rapports{% endblock %}

{% block psychologue_title %}Statistiques{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .border-left-primary { border-left: .25rem solid #4e73df!important; }
    .border-left-success { border-left: .25rem solid #1cc88a!important; }
    .border-left-info { border-left: .25rem solid #36b9cc!important; }
    .border-left-danger { border-left: .25rem solid #e74a3b!important; }
    .chart-area { position: relative; height: 320px; width: 100%; }
    .chart-pie { position: relative; height: 300px; width: 100%; }
    .card-header { background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0; }
</style>
{% endblock %}

{% block psychologue_body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Mes Statistiques</h1>
        <a href="{{ path('app_psychologue_statistiques_export') }}" class="btn btn-primary shadow-sm">
            <i class="fas fa-download fa-sm text-white-50"></i> Exporter Excel
        </a>
    </div>

    <!-- Cards Row -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total RDV</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ totalAppointments }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Confirmés</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ statsByStatus.CONFIRMED }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Terminés</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ statsByStatus.COMPLETED }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-flag-checkered fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Annulés</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ statsByStatus.CANCELLED }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Monthly Chart -->
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">RDV par mois (12 derniers mois)</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="monthlyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status Pie Chart -->
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Répartition par statut</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Daily Chart -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">RDV par jour de la semaine</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="dailyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Patients Table -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top 5 Patients</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>RDV</th>
                                    <th>Dernier RDV</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for patient in topPatients %}
                                <tr>
                                    <td>{{ patient.nom }} {{ patient.prenom }}</td>
                                    <td>{{ patient.count }}</td>
                                    <td>{{ patient.lastAppointment|date('d/m/Y') }}</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="3" class="text-center">Aucun patient trouvé</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
        let statCharts = [];

        function initStatCharts() {
            const monthlyEl = document.getElementById('monthlyChart');
            if (!monthlyEl || monthlyEl.dataset.initialized === '1') return;

            monthlyEl.dataset.initialized = '1';

            const monthLabels = {{ monthLabels|json_encode|raw }};
            const monthData = {{ monthData|json_encode|raw }};
            const statusLabels = {{ statusLabels|json_encode|raw }};
            const statusData = {{ statusData|json_encode|raw }};
            const dayLabels = {{ dayLabels|json_encode|raw }};
            const dayData = {{ dayData|json_encode|raw }};

            Chart.defaults.font.family = 'Nunito, -apple-system, system-ui, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
            Chart.defaults.color = '#858796';

            const monthlyCtx = document.getElementById('monthlyChart');
            if (monthlyCtx) {
                const chart = new Chart(monthlyCtx.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: monthLabels,
                        datasets: [{
                            label: "Nombre de RDV",
                            lineTension: 0.3,
                            backgroundColor: "rgba(78, 115, 223, 0.05)",
                            borderColor: "rgba(78, 115, 223, 1)",
                            pointRadius: 3,
                            pointBackgroundColor: "rgba(78, 115, 223, 1)",
                            pointBorderWidth: 2,
                            data: monthData,
                        }],
                    },
                    options: { maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
                });
                statCharts.push(chart);
            }

            const statusCtx = document.getElementById('statusChart');
            if (statusCtx) {
                const chart = new Chart(statusCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusData,
                            backgroundColor: ['#f6c23e', '#36b9cc', '#4e73df', '#1cc88a', '#e74a3b'],
                            hoverBackgroundColor: ['#dda20a', '#2c9faf', '#2e59d9', '#17a673', '#be2617'],
                        }],
                    },
                    options: { maintainAspectRatio: false, cutout: '70%', plugins: { legend: { display: true, position: 'bottom' } } }
                });
                statCharts.push(chart);
            }

            const dailyCtx = document.getElementById('dailyChart');
            if (dailyCtx) {
                const chart = new Chart(dailyCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: dayLabels,
                        datasets: [{
                            label: "Nombre de RDV",
                            backgroundColor: "#4e73df",
                            hoverBackgroundColor: "#2e59d9",
                            data: dayData,
                        }],
                    },
                    options: { maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
                });
                statCharts.push(chart);
            }

            document.addEventListener('turbo:before-cache', function cleanup() {
                statCharts.forEach(chart => chart.destroy());
                statCharts = [];
                delete monthlyEl.dataset.initialized;
                document.removeEventListener('turbo:before-cache', cleanup);
            });
        }

        document.addEventListener('turbo:load', initStatCharts);
        if (document.readyState !== 'loading') {
            initStatCharts();
        }
    </script>
{% endblock %}
