<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche compte</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 11pt;
            color: #1a1a1a;
            margin: 0;
            padding: 0;
        }
        .header {
            background: {{ brand.header_bg }};
            border-bottom: 4px solid {{ brand.primary }};
            padding: 16px 20px;
            display: table;
            width: 100%;
        }
        .header-row { display: table-row; }
        .header-cell { display: table-cell; vertical-align: middle; }
        .logo { max-height: 48px; max-width: 160px; }
        .brand-title {
            font-size: 16pt;
            font-weight: bold;
            color: {{ brand.accent }};
            margin: 0 0 4px 0;
        }
        .brand-sub { font-size: 9pt; color: #555; margin: 0; }
        .content { padding: 22px 20px; }
        h1 {
            font-size: 14pt;
            color: {{ brand.primary }};
            margin: 0 0 14px 0;
            border-bottom: 1px solid #ccc;
            padding-bottom: 6px;
        }
        table.meta { width: 100%; border-collapse: collapse; }
        table.meta th {
            text-align: left;
            width: 32%;
            padding: 8px 10px;
            background: #f4f6f9;
            border: 1px solid #dde2ea;
            font-weight: bold;
            color: {{ brand.accent }};
        }
        table.meta td {
            padding: 8px 10px;
            border: 1px solid #dde2ea;
        }
        .badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 9pt;
            font-weight: bold;
        }
        .badge-on { background: #d4edda; color: #155724; }
        .badge-off { background: #e2e3e5; color: #383d41; }
        .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            font-size: 8pt;
            color: #666;
            border-top: 1px solid #ccc;
            padding: 8px 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="header-row">
            <div class="header-cell" style="width: 38%;">
                {% if brand.logo_data_uri %}
                    <img class="logo" src="{{ brand.logo_data_uri }}" alt="Logo">
                {% else %}
                    <p class="brand-title" style="font-size: 13pt;">{{ brand.title }}</p>
                {% endif %}
            </div>
            <div class="header-cell">
                {% if brand.logo_data_uri %}
                    <p class="brand-title">{{ brand.title }}</p>
                {% endif %}
                <p class="brand-sub">Document généré le {{ generated_at|date('d/m/Y à H:i') }}</p>
            </div>
        </div>
    </div>

    <div class="content">
        <h1>Fiche compte utilisateur</h1>

        <table class="meta">
            <tr>
                <th>Identité</th>
                <td>{{ user.prenom }} {{ user.nom }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Téléphone</th>
                <td>{{ user.telephone ?: '—' }}</td>
            </tr>
            <tr>
                <th>Rôle</th>
                <td>{{ user.role }}</td>
            </tr>
            <tr>
                <th>Date d'inscription</th>
                <td>{{ user.dateInscription ? user.dateInscription|date('d/m/Y') : '—' }}</td>
            </tr>
            <tr>
                <th>Dernière connexion</th>
                <td>{{ user.derniereConnexion ? user.derniereConnexion|date('d/m/Y H:i') : '—' }}</td>
            </tr>
            <tr>
                <th>Statut actif</th>
                <td>
                    {% if user.estActif %}
                        <span class="badge badge-on">Actif</span>
                    {% else %}
                        <span class="badge badge-off">Inactif</span>
                    {% endif %}
                </td>
            </tr>
        </table>

    </div>

    <div class="footer">
        {{ brand.title }} — document réservé à l'administration — ne pas diffuser
    </div>
</body>
</html>
