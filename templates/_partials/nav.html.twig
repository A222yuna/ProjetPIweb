{% set r = app.request.attributes.get('_route') %}
{% set locale = app.request.locale %}
<a href="{{ path('app_home', {'_locale': locale}) }}" class="brand brand-link">
    <span class="brand-name">Cabinet de psychologie</span>
    <span class="brand-tagline">Consultation &amp; échanges</span>
</a>
<nav id="site-navigation" class="site-nav" aria-label="Navigation principale">
    <div class="nav-links">
        <a href="{{ path('app_home', {'_locale': locale}) }}" class="{{ r == 'app_home' ? 'is-active' : '' }}">Accueil</a>
        <a href="{{ path('app_cabinet', {'_locale': locale}) }}" class="{{ r == 'app_cabinet' ? 'is-active' : '' }}">Le cabinet</a>
        <a href="{{ path('app_consultation', {'_locale': locale}) }}" class="{{ r == 'app_consultation' or r == 'app_post_show' ? 'is-active' : '' }}">Consultations</a>
        <a href="{{ path('app_tarifs', {'_locale': locale}) }}" class="{{ r == 'app_tarifs' ? 'is-active' : '' }}">Tarifs</a>
        <a href="{{ path('app_reservation', {'_locale': locale}) }}" class="nav-cta {{ r == 'app_reservation' ? 'is-active' : '' }}">Prendre RDV</a>
        <a href="{{ path('app_contact', {'_locale': locale}) }}" class="{{ r == 'app_contact' ? 'is-active' : '' }}">Contact</a>
        
        {% if app.user %}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_dashboard', {'_locale': locale}) }}" class="nav-secondary {{ r starts with 'app_admin' ? 'is-active' : '' }}">Admin</a>
            {% elseif is_granted('ROLE_PSYCHOLOGUE') %}
                <a href="{{ path('app_psychologue_dashboard', {'_locale': locale}) }}" class="nav-secondary {{ r starts with 'app_psychologue' ? 'is-active' : '' }}">Espace Psy</a>
            {% else %}
                <a href="{{ path('app_patient_dashboard', {'_locale': locale}) }}" class="nav-secondary {{ r starts with 'app_patient' ? 'is-active' : '' }}">Mon Espace</a>
            {% endif %}
            <a href="{{ path('app_logout', {'_locale': app.request.locale}) }}" class="text-danger ms-2"><i class="fa-solid fa-power-off"></i></a>
        {% else %}
            <a href="{{ path('app_login', {'_locale': app.request.locale}) }}" class="ms-2">Connexion</a>
            <a href="{{ path('app_register', {'_locale': app.request.locale}) }}" class="btn btn-sm btn-primary rounded-pill px-3 ms-2">S'inscrire</a>
        {% endif %}
    </div>
</nav>
