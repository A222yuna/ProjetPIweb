<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Historique Patient - {{ patient.nom }} {{ patient.prenom }}</title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #333; font-size: 12px; }
        .header { background-color: #7C6BA0; color: white; padding: 20px; text-align: center; }
        .patient-info { margin: 20px 0; border: 1px solid #7C6BA0; padding: 15px; border-radius: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background-color: #5B9BD5; color: white; padding: 10px; text-align: left; }
        td { border-bottom: 1px solid #eee; padding: 10px; }
        .stats-grid { margin-top: 30px; }
        .stat-box { display: inline-block; width: 23%; background: #f8f9fa; padding: 10px; text-align: center; border-radius: 5px; margin-right: 1%; }
        .stat-value { font-size: 18px; font-weight: bold; color: #7C6BA0; }
        .footer { text-align: center; font-size: 10px; color: #999; margin-top: 30px; }
        .status { font-weight: bold; }
        .status-paid { color: #28a745; }
        .status-confirmed { color: #007bff; }
        .status-cancelled { color: #dc3545; }
    </style>
</head>
<body>
    <div class="header">
        <h1>PsyConnect</h1>
        <div>Historique des Rendez-vous / Appointment History</div>
    </div>

    <div class="patient-info">
        <strong>Patient:</strong> {{ patient.nom }} {{ patient.prenom }}<br>
        <strong>Email:</strong> {{ patient.email }}<br>
        <strong>Date du rapport:</strong> {{ generatedAt|date('d/m/Y') }}
    </div>

    <div class="stats-grid">
        <div class="stat-box">
            <div class="stat-value">{{ stats.total }}</div>
            <div>Total</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ stats.completed }}</div>
            <div>Terminés</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ stats.paid }}</div>
            <div>Payés</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ stats.cancelled }}</div>
            <div>Annulés</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Heure / Time</th>
                <th>Psychologue</th>
                <th>Statut / Status</th>
            </tr>
        </thead>
        <tbody>
            {% for a in appointments %}
                <tr>
                    <td>{{ a.plan.dayOfWeek }}</td>
                    <td>{{ a.plan.period }}</td>
                    <td>Dr. {{ a.plan.psychologue.nom }}</td>
                    <td class="status {% if a.status == 'PAID' %}status-paid{% elseif a.status == 'CONFIRMED' %}status-confirmed{% elseif a.status == 'CANCELLED' %}status-cancelled{% endif %}">
                        {{ a.status }}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" style="text-align: center;">Aucun rendez-vous trouvé.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Page 1/1 - PsyConnect &copy; {{ "now"|date("Y") }}
    </div>
</body>
</html>
