{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/cabinet.css') }}">
{% endblock %}

{% block body_attr %} class="app-dashboard"{% endblock %}

{% block body %}
    {% set route = app.request.attributes.get('_route')|default('') %}
    <div class="main-wrapper app-shell">
        <aside class="sidebar app-sidebar">
            <div class="app-logo">Back Office Admin</div>
            <ul class="app-nav">
                <li><a class="{{ route starts with 'app_admin_module_comptes' ? 'is-active' : '' }}" href="{{ path('app_admin_module_comptes') }}"><i class="fa-solid fa-users"></i>Comptes</a></li>
                <li><a class="{{ route starts with 'app_admin_module_consultations' ? 'is-active' : '' }}" href="{{ path('app_admin_module_consultations') }}"><i class="fa-solid fa-calendar-check"></i>Consultations</a></li>
                <li><a class="{{ route starts with 'app_admin_module_cabinets' or route starts with 'app_cabinet_' ? 'is-active' : '' }}" href="{{ path('app_admin_module_cabinets') }}"><i class="fa-solid fa-hospital"></i>Cabinets</a></li>
                <li><a class="{{ route starts with 'app_admin_module_bienetre' ? 'is-active' : '' }}" href="{{ path('app_admin_module_bienetre') }}"><i class="fa-solid fa-heart"></i>Bien-etre</a></li>
                <li><a class="{{ route starts with 'app_admin_module_messages' ? 'is-active' : '' }}" href="{{ path('app_admin_module_messages') }}"><i class="fa-solid fa-envelope"></i>Messages</a></li>
                <li><a class="{{ route starts with 'app_admin_module_forum' ? 'is-active' : '' }}" href="{{ path('app_admin_module_forum') }}"><i class="fa-solid fa-comments"></i>Forum</a></li>
            </ul>
            <div class="app-sidebar-user">
                <div class="app-avatar">{{ app.user ? app.user.prenom|slice(0, 1)|upper : 'U' }}</div>
                <div>
                    <div class="fw-semibold">{{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : 'Invite' }}</div>
                    <span class="app-role-chip">{{ app.user ? app.user.role : 'Anonyme' }}</span>
                </div>
            </div>
        </aside>
        <section class="content-area app-main">
            <div class="top-bar app-topbar">
                <div class="page-title">
                    <h1 class="app-topbar-title">Gestion cabinets</h1>
                    <span class="breadcrumb">Admin > Cabinets</span>
                </div>
                <div class="user-info app-topbar-right">
                    <span class="user-name">{{ app.user ? app.user.nom ~ ' ' ~ app.user.prenom : 'Invite' }}</span>
                    <span class="role-badge">{{ app.user ? app.user.role|upper : 'ANONYME' }}</span>
                    <a href="{{ path('app_logout') }}" class="btn-logout">Logout</a>
                </div>
            </div>
            <div class="page-content app-content">
                <div class="app-breadcrumb">Dashboard > <strong>Cabinets</strong></div>
                {% block admin_body %}{% endblock %}
            </div>
        </section>
    </div>
{% endblock %}
