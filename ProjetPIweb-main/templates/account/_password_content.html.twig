<h1 class="h4 mb-3">Changer mon mot de passe</h1>
<div class="card p-3 mb-3">
    <div class="alert alert-light border mb-0">Utilisez un mot de passe fort (8+ caracteres, lettres, chiffres, symboles).</div>
</div>
<div class="card p-3">
    {{ form_start(form, { attr: { class: 'stack-form' } }) }}
        {{ form_row(form.currentPassword, { label: 'Mot de passe actuel' }) }}
        {{ form_row(form.newPassword, { label: 'Nouveau mot de passe' }) }}
        <div class="stack-form-actions">
            <button class="btn btn-primary">Mettre a jour</button>
            <a href="{{ path('app_account_profile') }}" class="btn btn-outline-secondary">Retour profil</a>
        </div>
    {{ form_end(form) }}
</div>
