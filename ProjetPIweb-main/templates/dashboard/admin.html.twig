{% extends 'base_admin.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block admin_body %}
    <h1 class="h4 mb-3">Dashboard Administrateur</h1>
    <p class="text-muted">Vue globale de la plateforme de consultation psychologique.</p>

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Utilisateurs</small><div class="h4 mb-0">1 248</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">RDV planifies</small><div class="h4 mb-0">312</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Cabinets en attente</small><div class="h4 mb-0">14</div></div></div>
        <div class="col-md-3"><div class="card p-3"><small class="text-muted">Messages non lus</small><div class="h4 mb-0">87</div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h2 class="h6">Modules plateforme</h2>
                <ul class="mb-0">
                    <li><strong>Gestion des comptes</strong> - Activation, verification email, moderation.</li>
                    <li><strong>Consultations</strong> - Supervision des rendez-vous et statuts.</li>
                    <li><strong>Psychologues / Cabinets</strong> - Validation annonces et archivage.</li>
                    <li><strong>Bien-etre</strong> - Suivi programmes et avis.</li>
                    <li><strong>Messagerie</strong> - Controle de la moderation.</li>
                    <li><strong>Forum</strong> - Qualite des echanges et moderation contenu.</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h2 class="h6">Actions rapides</h2>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-primary" href="{{ path('app_admin_users_index') }}">Comptes</a>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_appointments_index') }}">Rendez-vous</a>
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_consultation') }}">Forum</a>
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_cabinet') }}">Cabinets</a>
                </div>
                <hr>
                <h3 class="h6">Alertes</h3>
                <ul class="mb-0">
                    <li>3 signalements forum en attente.</li>
                    <li>2 comptes psychologues a verifier.</li>
                    <li>5 annonces cabinet a valider.</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="card p-3 mt-3">
        <h2 class="h6">Timeline moderation</h2>
        <ul class="mb-0">
            <li>08:30 - Verification des nouveaux psychologues</li>
            <li>10:15 - Revue signalements forum</li>
            <li>14:00 - Validation annonces cabinets</li>
            <li>16:30 - Synthese qualite hebdomadaire</li>
        </ul>
    </div>
{% endblock %}
