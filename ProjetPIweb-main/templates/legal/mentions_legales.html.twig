{% extends 'base.html.twig' %}

{% block title %}Mentions légales — Cabinet de psychologie{% endblock %}

{% block body %}
    <p class="page-eyebrow">Informations réglementaires</p>
    <h1>Mentions légales</h1>
    <p class="page-lead muted">Texte type à compléter (éditeur, hébergeur, propriété intellectuelle, médiation, données personnelles / RGPD).</p>

    <div class="card">
        <h2>Éditeur du site</h2>
        <p class="muted">Raison sociale, adresse, SIREN/SIRET, représentant légal, statut professionnel, contact.</p>
    </div>
    <div class="card">
        <h2>Hébergement</h2>
        <p class="muted">Nom et coordonnées de l’hébergeur.</p>
    </div>
    <div class="card">
        <h2>Données personnelles</h2>
        <p class="muted" style="margin-bottom:0">Finalités, bases légales, durées de conservation, droits des personnes, DPO ou contact.</p>
    </div>
{% endblock %}
