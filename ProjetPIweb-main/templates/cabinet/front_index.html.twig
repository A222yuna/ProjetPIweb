{% extends 'front.html.twig' %}

{% block title %}Recherche de cabinets{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
{% endblock %}

{% block front_body %}
    <div class="hero-banner">
        <div class="hero-text">
            <h2>🧠 Explorer les cabinets</h2>
            <p>Bonjour {{ app.user ? app.user.prenom : 'Patient' }}, trouvez un cabinet adapte a votre besoin.</p>
        </div>
        <div class="hero-illustration">🏥</div>
    </div>

    <div class="search-card">
        <form method="get">
            <div class="search-row">
                <div class="search-input-wrapper">
                    <span class="search-icon">📍</span>
                    <input type="text" placeholder="Ville, adresse ou description..." class="search-input" name="q" value="{{ search }}">
                </div>
                <button class="btn-search" type="submit">🔍 Rechercher</button>
            </div>
            <div class="filter-chips">
                <span class="chip active" data-filter="tous">Tous</span>
                <span class="chip" data-filter="anxiete">Anxiete</span>
                <span class="chip" data-filter="depression">Depression</span>
                <span class="chip" data-filter="enfants">Enfants</span>
                <span class="chip" data-filter="couple">Couple</span>
                <span class="chip" data-filter="trauma">Trauma</span>
            </div>
        </form>
    </div>

    <div class="map-section">
        <div class="map-header">
            <h3>🗺️ Carte des cabinets</h3>
            <span class="map-subtitle">Visualisez tous les cabinets disponibles</span>
            <span id="map-count">Chargement...</span>
        </div>
        <div id="cabinets-map"></div>
        <div class="map-legend">
            <span class="legend-item">
                <span class="legend-dot legend-valid"></span> Cabinet valide
            </span>
            <span class="legend-item">
                <span class="legend-dot legend-pending"></span> En attente
            </span>
        </div>
    </div>

    <div class="results-header">
        <h3>{{ cabinets|length }} cabinet(s) trouve(s)</h3>
        <div class="sort-select">
            <select>
                <option>Trier par: Pertinence</option>
                <option>Trier par: Note</option>
                <option>Trier par: Distance</option>
            </select>
        </div>
    </div>

    <div class="cabinets-grid">
        {% for cabinet in cabinets %}
            <div class="cabinet-card">
                <div class="card-header-gradient"></div>
                <div class="card-body">
                    <div class="cabinet-avatar">🏥</div>
                    <div class="status-badge {{ cabinet.valide ? 'badge-valid' : 'badge-pending' }}">
                        {{ cabinet.valide ? 'Valide' : 'En attente' }}
                    </div>
                    <h3 class="cabinet-name">Cabinet {{ cabinet.ville }}</h3>
                    <p class="cabinet-address">📍 {{ cabinet.adresse }}, {{ cabinet.ville }}</p>
                    <div class="cabinet-rating">
                        {% set score = cabinet.reputationScore ?? 0 %}
                        {% set badge = cabinet.reputationBadge ?? 'Débutant' %}
                        {% set avgNote = cabinet.ratings|length > 0
                            ? (cabinet.ratings|reduce((carry, r) => carry + (r.noteGlobale ?? r.note), 0) / cabinet.ratings|length)
                            : 0 %}
                        {% for i in 1..5 %}
                            <span style="color:{{ i <= avgNote|round ? '#F59E0B' : '#E5E7EB' }};font-size:16px;">★</span>
                        {% endfor %}
                        <span class="rating-count">({{ cabinet.ratings|length }})</span>
                        {% if badge %}
                            <span class="rep-badge-inline rep-badge-inline--{{ badge|lower|replace({' ':'-'}) }}">
                                {% if badge == 'Excellence' %}💎{% elseif badge == 'Expert' %}🥇{% elseif badge == 'Confirmé' %}🥈{% else %}⭐{% endif %}
                                {{ badge }}
                            </span>
                        {% endif %}
                    </div>
                    <div class="card-divider"></div>
                    <div class="card-actions">
                        <a href="{{ path('app_cabinet_front_show', {'id': cabinet.id}) }}" class="btn-details">👁 Voir details</a>
                        <button type="button" class="btn-rdv">📅 Prendre RDV</button>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-icon">🔍</div>
                <h3>Aucun cabinet trouve</h3>
                <p>Essayez de modifier vos criteres de recherche</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mapElement = document.getElementById('cabinets-map');
            if (!mapElement || typeof L === 'undefined') {
                return;
            }

            const map = L.map('cabinets-map').setView([33.8869, 9.5375], 6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 18
            }).addTo(map);

            const purpleIcon = L.divIcon({
                html: '<div style="width:36px;height:36px;background:linear-gradient(135deg,#6B3FA0,#00BFA5);border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid white;box-shadow:0 4px 12px rgba(107,63,160,0.4);"></div>',
                className: '',
                iconSize: [36, 36],
                iconAnchor: [18, 36],
                popupAnchor: [0, -40]
            });

            fetch('/api/cabinets/map-data')
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    const countElement = document.getElementById('map-count');
                    if (!data.success || !data.cabinets || data.cabinets.length === 0) {
                        if (countElement) {
                            countElement.textContent = 'Aucun cabinet geolocalise';
                        }
                        return;
                    }

                    if (countElement) {
                        countElement.textContent = data.count + ' cabinet(s) sur la carte';
                    }

                    const bounds = [];

                    data.cabinets.forEach(function(cabinet) {
                        const marker = L.marker([cabinet.latitude, cabinet.longitude], { icon: purpleIcon }).addTo(map);

                        marker.bindPopup(
                            '<div style="font-family:Inter,sans-serif;min-width:200px;padding:4px;">' +
                                '<div style="background:linear-gradient(135deg,#6B3FA0,#00BFA5);color:white;padding:12px 16px;border-radius:10px 10px 0 0;margin:-4px -4px 12px;font-weight:700;font-size:15px;">🏥 Cabinet</div>' +
                                '<p style="margin:0 0 6px;color:#1A1A2E;font-size:13px;">📍 ' + cabinet.adresse + '</p>' +
                                '<p style="margin:0 0 12px;color:#6B7280;font-size:13px;">🏙️ ' + cabinet.ville + '</p>' +
                                '<span style="background:#D1FAE5;color:#065F46;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;">' + cabinet.statut + '</span>' +
                                '<br><br>' +
                                '<a href="' + cabinet.detail_url + '" style="display:block;text-align:center;background:#6B3FA0;color:white;padding:10px;border-radius:8px;text-decoration:none;font-weight:600;font-size:13px;margin-top:8px;">Voir le cabinet →</a>' +
                            '</div>',
                            { maxWidth: 240 }
                        );

                        bounds.push([cabinet.latitude, cabinet.longitude]);
                    });

                    if (bounds.length > 0) {
                        map.fitBounds(bounds, { padding: [40, 40] });
                    }
                })
                .catch(function(err) {
                    console.error('Map error:', err);
                });
        });
    </script>
{% endblock %}
