{% extends 'back.html.twig' %}

{% block title %}Modifier disponibilite{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .mc-modal-card { max-width: 760px; margin: 1rem auto; border: 2px solid #2abf9e; border-radius: 22px; box-shadow: 0 12px 28px rgba(0,0,0,.12); }
        .mc-input { border-radius: 12px; border: 2px solid #cfe9f7; padding: .7rem .9rem; }
        .mc-input:focus { border-color: #2abf9e; box-shadow: 0 0 0 .2rem rgba(42,191,158,.18); }
        .mc-action { border-radius: 12px; padding: .62rem 1.5rem; }
    </style>
{% endblock %}

{% block back_body %}
    <div class="card mc-modal-card bg-white">
        <div class="card-body p-4 p-md-5">
            <h2 class="text-primary fw-bold mb-4">Modifier la plage horaire</h2>
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="text-danger small mb-3">{{ form_errors(form) }}</div>
                <div class="mb-3">
                    {{ form_label(form.cabinet, 'Cabinet', {'label_attr': {'class': 'fw-semibold text-success'}}) }}
                    {{ form_widget(form.cabinet, {'attr': {'class': 'form-select mc-input'}}) }}
                    <div class="text-danger small">{{ form_errors(form.cabinet) }}</div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.jour, 'Jour (1=Lundi ... 7=Dimanche)', {'label_attr': {'class': 'fw-semibold text-success'}}) }}
                    {{ form_widget(form.jour, {'attr': {'class': 'form-select mc-input'}}) }}
                    <div class="text-danger small">{{ form_errors(form.jour) }}</div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.heureDebut, 'Heure debut (HH:mm)', {'label_attr': {'class': 'fw-semibold text-success'}}) }}
                    {{ form_widget(form.heureDebut, {'attr': {'class': 'form-control mc-input'}}) }}
                    <div class="text-danger small">{{ form_errors(form.heureDebut) }}</div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.heureFin, 'Heure fin (HH:mm)', {'label_attr': {'class': 'fw-semibold text-success'}}) }}
                    {{ form_widget(form.heureFin, {'attr': {'class': 'form-control mc-input'}}) }}
                    <div class="text-danger small">{{ form_errors(form.heureFin) }}</div>
                </div>
                <div class="mb-4">
                    {{ form_label(form.dureeConsultation, 'Duree consultation (minutes)', {'label_attr': {'class': 'fw-semibold text-success'}}) }}
                    {{ form_widget(form.dureeConsultation, {'attr': {'class': 'form-control mc-input'}}) }}
                    <div class="text-danger small">{{ form_errors(form.dureeConsultation) }}</div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-primary mc-action" type="submit">Mettre a jour</button>
                    <a href="{{ path(index_route|default('app_disponibilite_index')) }}" class="btn btn-outline-secondary mc-action">Fermer</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
