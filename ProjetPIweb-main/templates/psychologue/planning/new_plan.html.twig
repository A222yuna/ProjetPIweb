{% extends 'base_psychologue.html.twig' %}

{% block title %}Nouveau plan{% endblock %}

{% block psychologue_body %}
    <div class="card">
        <h1 class="h5">Nouveau plan psychologue</h1>
        {{ form_start(form, { attr: { class: 'stack-form' } }) }}
            {{ form_row(form.dayOfWeek) }}
            {{ form_row(form.period) }}
            {{ form_row(form.maxAppointments) }}
            <div class="stack-form-actions">
                <button class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_psychologue_planning_index') }}">Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
